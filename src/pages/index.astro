---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import PieceCard from '../components/PieceCard.astro';
import { lines, pieces, piecesOf, pieceBySlug } from '../data/pieces';
import { site } from '../data/site';
import { url } from '../lib/url';

const chosen = ['etude-02', 'etude-04', 'etude-07', 'etude-10'].map((s) => pieceBySlug(s)!);
const strip = [
  { s: 'kaftan', c: 'pois', shot: 'Kaftan à pois, dos au mur blanc, ombre portée nette' },
  { s: 'djellaba', c: 'eau', shot: 'Djellaba vert d’eau, capuche relevée, contre-jour' },
  { s: 'tenue', c: 'brique', shot: 'Tenue brique, assise, mains sur les genoux' },
  { s: 'gandoura', c: 'blanc', shot: 'Gandoura blanche sur fond vert, plan large' },
  { s: 'kaftan', c: 'nuit', shot: 'Kaftan nuit, lumière de soirée, détail de manche' },
] as const;
---
<Base tone="dark">
  <section class="hero on-dark" data-hero aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="kicker hero__k rv">Gandouras · Djellabas · Kaftans · Tenues</p>
      <h1 id="hero-title" class="hero__mark">
        <span class="hero__l1">Kuskusi</span>
        <em class="hero__l2">Kouture</em>
      </h1>
      <div class="hero__foot rv">
        <p class="hero__lead">Les nouveautés, modèles et créations de {site.designer}, réunis dans une maison numérique.</p>
        <div class="hero__cta">
          <a class="btn btn--light" href={url('collections/')}>Découvrir les créations</a>
          <a class="link" href={url('lookbook/')}>Le lookbook</a>
        </div>
      </div>
    </div>
    <div class="hero__plate">
      <Plate silhouette="kaftan" colour="vert" shot="kaftan vert à broderie blanche, en pied, lumière du nord, fond pâle" caption="full" uid="hero" field="#a8b9a7" />
    </div>
  </section>

  <section class="lines wrap" aria-labelledby="lines-title">
    <header class="sec-head">
      <p class="kicker">Les lignes de la maison</p>
      <h2 id="lines-title" class="sec-title">Quatre silhouettes,<br /><em>une seule écriture.</em></h2>
    </header>
    <ol class="lines__list">
      {lines.map((l) => (
        <li class="rv">
          <a href={url(`collections/${l.slug}/`)} class="lines__row">
            <span class="lines__no">{l.no}</span>
            <span class="lines__name">{l.name}</span>
            <span class="lines__count small">{piecesOf(l.slug).length} études</span>
            <span class="lines__thumb" aria-hidden="true">
              <Plate silhouette={l.silhouette} colour={piecesOf(l.slug)[0].colours[0]} shot={l.shot} caption="none" uid={`line-${l.slug}`} />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="chosen wrap" aria-labelledby="chosen-title">
    <header class="sec-head sec-head--split">
      <h2 id="chosen-title" class="sec-title">Études <em>choisies</em></h2>
      <p class="small muted measure">Pièces de démonstration : silhouettes et coloris illustratifs, en attente des créations et photographies réelles de la maison.</p>
    </header>
    <div class="chosen__grid">
      {chosen.map((p, i) => (
        <PieceCard piece={p} class={`rv chosen__${i}`} ar={i === 0 ? '4 / 5' : i === 3 ? '4 / 5' : '3 / 4'} />
      ))}
    </div>
    <p class="chosen__all"><a class="link" href={url('collections/')}>Toutes les créations ({pieces.length})</a></p>
  </section>

  <section class="statement" aria-label="La maison">
    <div class="wrap">
      <hr class="stitch" />
      <p class="statement__t serif rv">
        Une maison de <em>gandouras, djellabas, kaftans</em> et <em>tenues</em> — et un nom qui se retient au premier regard.
      </p>
      <p class="small muted statement__src">D’après la présentation publique de la maison : « Les nouveautés, modèles et créations de {site.designer}. »</p>
      <a class="link" href={url('maison/')}>La maison</a>
    </div>
  </section>

  <section class="strip" aria-labelledby="strip-title">
    <div class="wrap sec-head sec-head--split">
      <h2 id="strip-title" class="sec-title">Lookbook, <em>chapitre proposé</em></h2>
      <a class="link" href={url('lookbook/')}>Ouvrir le lookbook</a>
    </div>
    <ul class="strip__track" tabindex="0" aria-label="Aperçu du lookbook, défilement horizontal">
      {strip.map((x, i) => (
        <li>
          <Plate silhouette={x.s} colour={x.c} shot={x.shot} numeral={String(i + 1).padStart(2, '0')} caption="none" uid={`strip-${i}`} />
          <p class="small"><span class="kicker">Look {String(i + 1).padStart(2, '0')}</span><br /><span class="muted">Photo à venir — {x.shot}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="atelier wrap" aria-labelledby="atelier-title">
    <div class="atelier__head">
      <p class="kicker">Demander une pièce</p>
      <h2 id="atelier-title" class="sec-title">Du regard<br /><em>au message.</em></h2>
      <p class="small muted">Parcours proposé — les modalités réelles (délais, sur-mesure, livraison) restent à confirmer avec la maison.</p>
    </div>
    <ol class="atelier__steps">
      <li class="rv"><span class="atelier__n serif">i.</span><div><h3>Choisir</h3><p>Coloris et taille, ou la mention « sur mesure » pour en discuter.</p></div></li>
      <li class="rv"><span class="atelier__n serif">ii.</span><div><h3>Composer</h3><p>Réunissez vos pièces dans votre sélection, modifiez les quantités à tout moment.</p></div></li>
      <li class="rv"><span class="atelier__n serif">iii.</span><div><h3>Écrire</h3><p>Le site prépare un message récapitulatif à adresser à la maison sur Instagram. Rien n’est envoyé automatiquement.</p></div></li>
    </ol>
    <div class="atelier__cta"><a class="btn btn--solid" href={url('selection/')}>Voir ma sélection</a></div>
  </section>
</Base>

<style>
  .hero { position: relative; background: var(--bottle); color: var(--embroidery); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: calc(100svh - var(--header-h) - 2rem); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; background: var(--grain); opacity: 0.22; mix-blend-mode: soft-light; pointer-events: none; }
  .hero__copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 4vw, 3.5rem) 0 clamp(1.5rem, 4vw, 3rem) var(--gutter); }
  .hero__k { color: #cfdad2; }
  .hero__mark { font-size: var(--fs-mega); line-height: 0.8; margin: 0; width: max-content; font-variation-settings: 'opsz' 96; animation: markIn 1.4s var(--ease) both; }
  .hero__l1 { display: block; text-transform: uppercase; letter-spacing: -0.045em; margin-left: -0.04em; }
  .hero__l2 { display: block; font-size: 0.52em; text-align: right; margin-top: -0.02em; letter-spacing: -0.03em; padding-right: 0.06em; }
  @keyframes markIn { from { opacity: 0; transform: translateY(0.12em); letter-spacing: 0.02em; } }
  .hero__foot { display: grid; grid-template-columns: minmax(0, 22rem) auto; gap: 1.5rem 3rem; align-items: end; }
  .hero__lead { font-family: var(--serif); font-size: var(--fs-3); line-height: 1.25; margin: 0; font-variation-settings: 'opsz' 28; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 1.25rem 1.5rem; align-items: center; }
  .hero__cta .link { color: var(--embroidery); }
  .hero__plate { position: relative; z-index: 1; padding: clamp(1rem, 3vw, 2.5rem) var(--gutter) clamp(1rem, 3vw, 2.5rem) 0; display: flex; }
  .hero__plate :global(.plate) { aspect-ratio: auto; height: 100%; min-height: 28rem; animation: plateIn 1.6s 0.15s var(--ease) both; }
  @keyframes plateIn { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero__copy { padding: 1.5rem var(--gutter) 0; }
    .hero__mark { font-size: 19.4vw; margin-top: 1.25rem; }
    .hero__foot { order: 3; grid-template-columns: 1fr; padding: 0 var(--gutter) 2rem; }
    .hero__plate { padding: 0 var(--gutter); margin-top: -2.2rem; }
    .hero__plate :global(.plate) { aspect-ratio: 4 / 5; min-height: 0; height: auto; }
    .hero { display: flex; flex-direction: column; }
    .hero__copy { display: contents; }
    .hero__k { padding: 1.5rem var(--gutter) 0; margin: 0; }
    .hero__mark { padding-inline: var(--gutter); position: relative; z-index: 2; }
    .hero__plate { order: 2; }
    .hero__foot { padding-top: 1.75rem; }
  }

  .sec-head { margin: clamp(5rem, 11vw, 10rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .sec-head--split { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; flex-wrap: wrap; }
  .sec-title { font-size: var(--fs-1); margin-top: 0.75rem; }

  .lines__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .lines__row { display: grid; grid-template-columns: 4rem 1fr auto 0; align-items: center; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: grid-template-columns 0.8s var(--ease), padding 0.6s var(--ease); }
  .lines__no { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.14em; }
  .lines__name { font-family: var(--serif); font-size: var(--fs-2); line-height: 1; font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; transition: transform 0.7s var(--ease), font-style 0s; }
  .lines__count { color: var(--ink-2); }
  .lines__thumb { width: 100%; overflow: hidden; }
  .lines__thumb :global(.plate) { aspect-ratio: 1; }
  @media (hover: hover) and (min-width: 861px) {
    .lines__row:hover, .lines__row:focus-visible { grid-template-columns: 4rem 1fr auto 9rem; }
    .lines__row:hover .lines__name { transform: translateX(1rem); font-style: italic; }
  }
  @media (max-width: 860px), (hover: none) {
    .lines__row { grid-template-columns: 2rem minmax(0, 1fr) auto 4rem; gap: 0.75rem; }
    .lines__name { font-size: clamp(1.7rem, 8.4vw, 2.6rem); }
  }

  .chosen__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 5rem) var(--gutter); align-items: start; }
  .chosen__grid > :global(.chosen__0) { grid-column: 1 / span 7; }
  .chosen__grid > :global(.chosen__1) { grid-column: 9 / span 4; margin-top: 30%; }
  .chosen__grid > :global(.chosen__2) { grid-column: 2 / span 4; }
  .chosen__grid > :global(.chosen__3) { grid-column: 7 / span 6; margin-top: -12%; }
  .chosen__all { margin-top: 3rem; text-align: right; }
  @media (max-width: 860px) {
    .chosen__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 0.75rem; }
    .chosen__grid > :global(.chosen__0), .chosen__grid > :global(.chosen__3) { grid-column: 1 / -1; margin: 0; }
    .chosen__grid > :global(.chosen__1), .chosen__grid > :global(.chosen__2) { grid-column: auto; margin: 0; }
    .chosen__grid > :global(.chosen__2) { margin-top: 3rem; }
    .chosen__all { text-align: left; }
  }

  .statement { margin-top: clamp(5rem, 11vw, 10rem); }
  .statement__t { font-size: var(--fs-2); line-height: 1.08; max-width: 18ch; margin: clamp(2rem, 5vw, 4rem) 0 1.5rem; }
  .statement__src { max-width: 40rem; }

  .strip__track { list-style: none; margin: 0; padding: 0 var(--gutter) 1rem; display: grid; grid-auto-flow: column; grid-auto-columns: clamp(15rem, 28vw, 26rem); gap: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: thin; overscroll-behavior-x: contain; }
  .strip__track > li { scroll-snap-align: start; }
  .strip__track > li:nth-child(even) { padding-top: 4rem; }
  .strip__track p { margin-top: 0.75rem; }
  @media (max-width: 860px) { .strip__track { grid-auto-columns: 72vw; } .strip__track > li:nth-child(even) { padding-top: 2rem; } }

  .atelier { display: grid; grid-template-columns: 5fr 7fr; gap: 2rem var(--gutter); margin-top: clamp(5rem, 11vw, 10rem); }
  .atelier__head .sec-title { margin-bottom: 1.25rem; }
  .atelier__steps { list-style: none; margin: 0; padding: 0; align-self: end; }
  .atelier__steps li { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding: 1.75rem 0; border-top: 1px solid var(--line); }
  .atelier__steps h3 { font-size: var(--fs-3); margin-bottom: 0.4rem; }
  .atelier__steps p { margin: 0; color: var(--ink-2); max-width: 32rem; }
  .atelier__n { font-size: 2.6rem; font-style: italic; line-height: 0.8; color: var(--bottle-2); }
  .atelier__cta { grid-column: 2; }
  @media (max-width: 860px) { .atelier { grid-template-columns: 1fr; } .atelier__cta { grid-column: 1; } .atelier__steps li { grid-template-columns: 3.25rem 1fr; } .atelier__cta .btn { width: 100%; } }
</style>
