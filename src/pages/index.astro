---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import GalleryItem from '../components/GalleryItem.astro';
import Lightbox from '../components/Lightbox.astro';
import { lines } from '../data/collections';
import { site } from '../data/site';
import { url } from '../lib/url';

const strip = [
  { s: 'kaftan', c: 'pois', shot: 'Kaftan à pois, dos au mur blanc, ombre portée nette' },
  { s: 'djellaba', c: 'eau', shot: 'Djellaba vert d’eau, capuche relevée, contre-jour' },
  { s: 'tenue', c: 'brique', shot: 'Tenue brique, assise, mains sur les genoux' },
  { s: 'gandoura', c: 'blanc', shot: 'Gandoura blanche sur fond vert, plan large' },
  { s: 'kaftan', c: 'nuit', shot: 'Kaftan nuit, lumière de soirée, détail de manche' },
] as const;
const feed = [
  { s: 'kaftan', c: 'vert', crop: 'detail' },
  { s: 'tenue', c: 'pois', crop: 'full' },
  { s: 'djellaba', c: 'noir', crop: 'back' },
  { s: 'gandoura', c: 'eau', crop: 'full' },
  { s: 'kaftan', c: 'brique', crop: 'motion' },
  { s: 'tenue', c: 'vert', crop: 'detail' },
] as const;
---
<Base tone="dark">
  <!-- 00 · Hero -->
  <section class="hero on-dark" data-hero aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="kicker hero__k">Gandouras · Djellabas · Kaftans · Tenues</p>
      <h1 id="hero-title" class="hero__mark">
        <span class="hero__l1" aria-hidden="true">{[...'Kuskusi'].map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}</span>
        <em class="hero__l2" aria-hidden="true">Kouture</em>
        <span class="sr-only">Kuskusi Kouture</span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lead">Les nouveautés, modèles et créations de {site.designer}.</p>
        <div class="hero__cta">
          <a class="btn btn--light" href="#collections">Voir les collections</a>
          <a class="link" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">Écrire à la maison<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
        </div>
      </div>
    </div>
    <div class="hero__plate">
      <Plate silhouette="kaftan" colour="vert" shot="kaftan vert à broderie blanche, en pied, lumière du nord, fond pâle" caption="full" uid="hero" field="#a8b9a7" />
    </div>
    <a class="hero__scroll" href="#maison" aria-label="Descendre vers la maison"><span></span></a>
  </section>

  <!-- 01 · La maison -->
  <section id="maison" class="wrap maison" aria-labelledby="maison-title">
    <p class="kicker sec-k"><span>01</span> La maison</p>
    <div class="maison__grid">
      <h2 id="maison-title" class="maison__lead rv">Derrière le nom, une signature&nbsp;: <em>les créations de {site.designer}.</em></h2>
      <div class="maison__copy rv">
        <p>Kuskusi Kouture présente publiquement « les nouveautés, modèles et créations de {site.designer} », en quatre lignes : gandouras, djellabas, kaftans et tenues. C’est sur Instagram que la maison partage ses pièces avec sa communauté.</p>
        <p>Ce concept imagine sa vitrine : un lieu calme et éditorial, où chaque silhouette est montrée comme dans un magazine — et où l’on écrit à la maison en un geste.</p>
        <hr class="stitch" />
        <dl class="facts">
          <div><dt>Créatrice</dt><dd>{site.designer}</dd></div>
          <div><dt>Lignes</dt><dd>Gandouras, djellabas, kaftans, tenues</dd></div>
          <div><dt>Canal officiel</dt><dd><a href={site.instagram.url} target="_blank" rel="noopener noreferrer">Instagram @{site.instagram.handle}<span class="sr-only"> (nouvel onglet)</span></a></dd></div>
          <div><dt>Rencontre</dt><dd>Spring Pop-Up, Mooon Studio, Casablanca — avril 2026</dd></div>
        </dl>
      </div>
      <div class="maison__plate rv">
        <Plate silhouette="djellaba" colour="noir" shot="portrait de la créatrice à l’atelier, mains au travail — uniquement sur validation" caption="full" uid="maison" numeral="Z" />
      </div>
    </div>
  </section>

  <!-- 02 · Collections (gallery) -->
  <section id="collections" class="coll" aria-labelledby="coll-title">
    <div class="wrap coll__head">
      <p class="kicker sec-k"><span>02</span> Collections</p>
      <h2 id="coll-title" class="sec-title">Quatre lignes,<br /><em>une seule écriture.</em></h2>
      <nav class="coll__index" aria-label="Lignes">
        {lines.map((l) => <a href={`#${l.slug}`}><span>{l.no}</span>{l.name}</a>)}
      </nav>
      <p class="small muted coll__note">Galerie de démonstration : chaque image est un emplacement dessiné qui décrit la photographie à réaliser avec la maison. Touchez une image pour l’agrandir.</p>
    </div>

    {lines.map((l, li) => (
      <article id={l.slug} class:list={['ch', 'wrap', `ch--${l.looks.length}`, li % 2 && 'ch--rev']} aria-labelledby={`${l.slug}-t`}>
        <header class="ch__head rv">
          <span class="ch__no serif" aria-hidden="true">{l.no}</span>
          <h3 id={`${l.slug}-t`} class="ch__t">{l.name}</h3>
          <p class="ch__intro">{l.intro}</p>
        </header>
        <div class="ch__grid">
          {l.looks.map((k, i) => (
            <GalleryItem class={`rv ch__i${i}`} silhouette={l.silhouette} colour={k.colour} crop={k.crop} shot={k.shot} ref={k.ref} line={l.singular} uid={`g-${k.ref}`} numeral={k.crop === 'full' ? l.no : undefined} ar={i === 0 ? '4 / 5' : k.crop === 'detail' ? '1 / 1' : '3 / 4'} />
          ))}
        </div>
      </article>
    ))}
  </section>

  <!-- Interlude -->
  <section class="inter" aria-hidden="true">
    <p class="inter__w serif"><em>Vert, blanc</em> &amp; pois</p>
  </section>

  <!-- 03 · Créations -->
  <section id="creations" class="wrap crea" aria-labelledby="crea-title">
    <p class="kicker sec-k"><span>03</span> Créations</p>
    <div class="crea__head">
      <h2 id="crea-title" class="sec-title">Ce que crée<br /><em>la maison.</em></h2>
      <p class="muted measure">Les quatre lignes annoncées par la maison. Les descriptions décrivent le type de vêtement ; matières, façons, sur-mesure et délais seront précisés avec elle.</p>
    </div>
    <ol class="crea__list">
      {lines.map((l) => (
        <li class="rv">
          <a href={`#${l.slug}`} class="crea__row">
            <span class="crea__no">{l.no}</span>
            <span class="crea__name">{l.name}</span>
            <span class="crea__about">{l.about}</span>
            <span class="crea__thumb" aria-hidden="true">
              <Plate silhouette={l.silhouette} colour={l.looks[0].colour} shot={l.looks[0].shot} caption="none" uid={`crea-${l.slug}`} decorative />
            </span>
          </a>
        </li>
      ))}
    </ol>
    <div class="crea__offer rv">
      <div>
        <p class="kicker">Nouveautés &amp; modèles</p>
        <p class="serif crea__offer-t">Chaque nouvelle pièce, présentée d’abord sur Instagram.</p>
      </div>
      <dl class="facts facts--tight">
        <div><dt>Demandes</dt><dd>Message direct sur Instagram, canal officiel</dd></div>
        <div><dt>Sur mesure</dt><dd><em>À confirmer avec la maison</em></dd></div>
        <div><dt>Délais &amp; livraison</dt><dd><em>À confirmer avec la maison</em></dd></div>
      </dl>
    </div>
  </section>

  <!-- Lookbook teaser -->
  <section class="strip" aria-labelledby="strip-title">
    <div class="wrap strip__head">
      <h2 id="strip-title" class="sec-title">Lookbook, <em>chapitre&nbsp;I</em></h2>
      <a class="link" href={url('lookbook/')}>Ouvrir le lookbook</a>
    </div>
    <ul class="strip__track" tabindex="0" aria-label="Aperçu du lookbook, défilement horizontal">
      {strip.map((x, i) => (
        <li>
          <a href={url('lookbook/')} class="strip__a" aria-label={`Look ${String(i + 1).padStart(2, '0')} — ouvrir le lookbook`}>
            <Plate silhouette={x.s} colour={x.c} shot={x.shot} numeral={String(i + 1).padStart(2, '0')} caption="none" uid={`strip-${i}`} decorative />
          </a>
          <p class="small"><span class="kicker">Look {String(i + 1).padStart(2, '0')}</span><br /><span class="muted">Photo à venir — {x.shot}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 04 · Présence -->
  <section id="presence" class="wrap pres" aria-labelledby="pres-title">
    <p class="kicker sec-k"><span>04</span> En ligne</p>
    <div class="pres__grid">
      <div class="pres__copy">
        <h2 id="pres-title" class="sec-title">Suivre<br /><em>la maison.</em></h2>
        <p class="muted">Les créations de la maison vivent sur son compte Instagram officiel. Ici, une grille éditoriale pourra accueillir ses publications, intégrées avec son accord.</p>
        <a class="pres__ig serif" href={site.instagram.url} target="_blank" rel="noopener noreferrer">@{site.instagram.handle}<span aria-hidden="true"> ↗</span><span class="sr-only"> — Instagram, nouvel onglet</span></a>
        <p class="small muted pres__press">Vue au Spring Pop-Up de Mooon Studio, Casablanca, avril 2026 — <a href="https://mwnlifestyle.com/2026/04/16/casablancas-spring-pop-up-spotlights-new-moroccan-labels/" target="_blank" rel="noopener noreferrer">MWN Lifestyle<span class="sr-only"> (nouvel onglet)</span></a>.</p>
      </div>
      <ul class="pres__feed" aria-label="Emplacements de publications Instagram">
        {feed.map((f, i) => (
          <li class="rv">
            <Plate silhouette={f.s} colour={f.c} crop={f.crop} shot={`publication Instagram n°${i + 1} de la maison, intégrée sur validation`} caption="none" uid={`feed-${i}`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 · Contact -->
  <section id="contact" class="ct on-dark" aria-labelledby="ct-title">
    <div class="wrap">
      <p class="kicker sec-k"><span>05</span> Demandes &amp; commandes</p>
      <h2 id="ct-title" class="ct__t">Une pièce<br /><em>vous attend&nbsp;?</em></h2>
      <div class="ct__grid">
        <ol class="ct__steps">
          <li><span class="serif">i.</span><div><h3>Repérer</h3><p>Choisissez une silhouette dans la galerie et notez sa référence.</p></div></li>
          <li><span class="serif">ii.</span><div><h3>Écrire</h3><p>Envoyez un message à la maison sur Instagram, avec la référence et votre taille.</p></div></li>
          <li><span class="serif">iii.</span><div><h3>Échanger</h3><p>La maison vous répond directement — disponibilités, délais et modalités sont à confirmer avec elle.</p></div></li>
        </ol>
        <div class="ct__actions">
          <a class="ct__dm" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">
            <span class="kicker">Message direct · Instagram</span>
            <span class="serif ct__dm-t">Écrire à la maison <span aria-hidden="true">↗</span></span>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
          <a class="btn btn--light" href={site.instagram.url} target="_blank" rel="noopener noreferrer">Voir le profil @{site.instagram.handle}<span class="sr-only"> (nouvel onglet)</span></a>
          {site.whatsapp && <a class="btn btn--light" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (nouvel onglet)</span></a>}
          {site.facebook && <a class="btn btn--light" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook<span class="sr-only"> (nouvel onglet)</span></a>}
          <blockquote class="ct__tpl">
            <p class="kicker">Exemple de message</p>
            <p>« Bonjour, je suis intéressée par le modèle KA-01 en taille 40. Est-il disponible, et quels sont les délais&nbsp;? Merci&nbsp;! »</p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; background: var(--bottle); color: var(--embroidery); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: calc(100svh - var(--header-h) - 2rem); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; background: var(--grain); opacity: 0.22; mix-blend-mode: soft-light; pointer-events: none; }
  .hero__copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 4vw, 3.5rem) 0 clamp(1.5rem, 4vw, 3rem) var(--gutter); }
  .hero__k { color: #cfdad2; animation: fadeUp 1s 0.2s var(--ease) both; }
  .hero__mark { font-size: var(--fs-mega); line-height: 0.8; margin: 0; width: max-content; font-variation-settings: 'opsz' 96; }
  .hero__l1 { display: block; text-transform: uppercase; letter-spacing: -0.045em; margin-left: -0.04em; }
  .hero__l1 > span { display: inline-block; animation: letterIn 1.3s calc(0.1s + var(--i) * 0.07s) var(--ease) both; }
  .hero__l2 { display: block; font-size: 0.52em; text-align: right; margin-top: -0.02em; letter-spacing: -0.03em; padding-right: 0.06em; animation: fadeUp 1.4s 0.75s var(--ease) both; }
  @keyframes letterIn { from { opacity: 0; transform: translateY(0.35em) rotate(4deg); filter: blur(6px); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(0.6rem); } }
  .hero__foot { display: grid; grid-template-columns: minmax(0, 22rem) auto; gap: 1.5rem 3rem; align-items: end; animation: fadeUp 1s 1s var(--ease) both; }
  .hero__lead { font-family: var(--serif); font-size: var(--fs-3); line-height: 1.25; margin: 0; font-variation-settings: 'opsz' 28; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 1.25rem 1.5rem; align-items: center; }
  .hero__cta .link { color: var(--embroidery); }
  .hero__plate { position: relative; z-index: 1; padding: clamp(1rem, 3vw, 2.5rem) var(--gutter) clamp(1rem, 3vw, 2.5rem) 0; display: flex; }
  .hero__plate :global(.plate) { aspect-ratio: auto; height: 100%; min-height: 28rem; animation: plateIn 1.6s 0.15s var(--ease) both; }
  .hero__plate :global(.plate__figure) { animation: drift 14s 1.6s ease-in-out infinite alternate; }
  @keyframes plateIn { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
  @keyframes drift { to { transform: translateY(-1.2%) scale(1.02); } }
  .hero__scroll { position: absolute; left: 50%; bottom: 0; z-index: 3; width: 44px; height: 64px; display: grid; justify-items: center; }
  .hero__scroll span { width: 1px; height: 100%; background: linear-gradient(var(--embroidery) 50%, transparent 50%) 0 0 / 1px 200% ; animation: line 2.4s ease-in-out infinite; }
  @keyframes line { from { background-position: 0 100%; } to { background-position: 0 -100%; } }

  @media (max-width: 860px) {
    .hero { display: flex; flex-direction: column; min-height: 0; }
    .hero__copy { display: contents; }
    .hero__k { padding: 1.5rem var(--gutter) 0; margin: 0; }
    .hero__mark { font-size: 19.4vw; margin-top: 1.25rem; padding-inline: var(--gutter); position: relative; z-index: 2; }
    .hero__plate { order: 2; padding: 0 var(--gutter); margin-top: -2.2rem; }
    .hero__plate :global(.plate) { aspect-ratio: 4 / 5; min-height: 0; height: auto; }
    .hero__foot { order: 3; grid-template-columns: 1fr; padding: 1.75rem var(--gutter) 3.5rem; }
    .hero__scroll { display: none; }
  }

  /* ---------- Shared ---------- */
  .sec-k { display: flex; gap: 1rem; align-items: center; margin: 0 0 1.5rem; }
  .sec-k span { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 1px solid currentColor; border-radius: 50%; letter-spacing: 0; }
  .sec-title { font-size: var(--fs-1); }
  .facts { margin: 0; }
  .facts div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.9rem 0; border-top: 1px solid var(--line); }
  .facts dt { font: 600 0.6875rem/1.7 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .facts dd { margin: 0; }
  .facts a { display: inline-flex; min-height: 44px; align-items: center; margin-block: -0.7rem; }

  /* ---------- Maison ---------- */
  .maison { padding-top: clamp(5rem, 11vw, 10rem); }
  .maison__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem var(--gutter); align-items: start; }
  .maison__lead { grid-column: 1 / span 7; grid-row: 1; font-size: var(--fs-2); line-height: 1.04; }
  .maison__copy { grid-column: 1 / span 6; grid-row: 2; max-width: 36rem; }
  .maison__copy > p { color: var(--ink-2); }
  .maison__copy .stitch { margin: 2.5rem 0 2rem; }
  .maison__plate { grid-column: 9 / span 4; grid-row: 1 / span 2; margin-top: 4rem; }
  @media (max-width: 860px) {
    .maison__lead, .maison__copy, .maison__plate { grid-column: 1 / -1; grid-row: auto; margin: 0; }
    .facts div { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  /* ---------- Collections ---------- */
  .coll { padding-top: clamp(5rem, 11vw, 10rem); }
  .coll__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .coll__index { display: flex; flex-wrap: wrap; gap: 0.25rem 2.25rem; margin-top: 2.5rem; border-top: 1px solid var(--ink); padding-top: 1rem; }
  .coll__index a { font-family: var(--serif); font-size: clamp(1.4rem, 2.4vw, 2rem); text-decoration: none; display: inline-flex; gap: 0.5rem; align-items: baseline; min-height: 44px; transition: color 0.3s; }
  .coll__index a:hover { font-style: italic; color: var(--bottle-2); }
  .coll__index span { font: 500 0.6875rem/1 var(--sans); letter-spacing: 0.14em; }
  .coll__note { margin-top: 1rem; max-width: 40rem; }

  .ch { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem var(--gutter); padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--line); }
  .ch__head { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .ch__no { display: block; font-size: clamp(5rem, 10vw, 9rem); line-height: 0.8; font-style: italic; color: var(--bottle-2); opacity: 0.9; }
  .ch__t { font-size: clamp(2.6rem, 5.5vw, 5rem); margin: 0.5rem 0 1rem; }
  .ch__intro { color: var(--ink-2); max-width: 24rem; }
  .ch__grid { grid-column: 5 / span 8; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem) var(--gutter); align-items: start; }
  .ch--rev .ch__head { grid-column: 9 / span 4; grid-row: 1; }
  .ch--rev .ch__grid { grid-column: 1 / span 8; grid-row: 1; }
  .ch__grid > :global(.ch__i0) { grid-column: 1 / span 5; }
  .ch__grid > :global(.ch__i1) { grid-column: 6 / span 3; margin-top: 45%; }
  .ch__grid > :global(.ch__i2) { grid-column: 2 / span 3; }
  .ch__grid > :global(.ch__i3) { grid-column: 5 / span 4; margin-top: 3rem; }
  .ch--3 .ch__grid > :global(.ch__i2) { grid-column: 3 / span 4; margin-top: 0; }
  @media (max-width: 860px) {
    .ch { grid-template-columns: 1fr; gap: 1.5rem; }
    .ch__head, .ch--rev .ch__head { grid-column: 1; grid-row: auto; position: static; }
    .ch__no { font-size: 4.5rem; }
    .ch__grid, .ch--rev .ch__grid { grid-column: 1; grid-row: auto; grid-template-columns: 1fr 1fr; gap: 1.75rem 0.75rem; }
    .ch__grid > :global(.ch__i0) { grid-column: 1 / -1; }
    .ch__grid > :global(.ch__i1), .ch__grid > :global(.ch__i2), .ch__grid > :global(.ch__i3), .ch--3 .ch__grid > :global(.ch__i2) { grid-column: auto; margin: 0; }
    .ch__grid > :global(.ch__i2) { margin-top: 2.5rem; }
    .ch--3 .ch__grid > :global(.ch__i2) { margin-top: 2.5rem; }
    .ch__grid > :global(.ch__i3) { grid-column: 1 / -1; }
  }

  /* ---------- Interlude ---------- */
  .inter { overflow: hidden; padding-block: clamp(3rem, 8vw, 7rem); }
  .inter__w { margin: 0; font-size: clamp(3rem, 12.5vw, 15rem); line-height: 0.85; white-space: nowrap; letter-spacing: -0.05em; color: var(--bottle); text-align: center; }
  .inter__w em { color: var(--ink); }

  /* ---------- Créations ---------- */
  .crea__head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .crea__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .crea__row { display: grid; grid-template-columns: 4rem minmax(0, 1.1fr) minmax(0, 1fr) 0; align-items: center; gap: 1.5rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: grid-template-columns 0.8s var(--ease); }
  .crea__no { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.14em; }
  .crea__name { font-family: var(--serif); font-size: var(--fs-2); line-height: 1; letter-spacing: -0.02em; transition: transform 0.7s var(--ease); }
  .crea__about { color: var(--ink-2); max-width: 26rem; }
  .crea__thumb { overflow: hidden; }
  .crea__thumb :global(.plate) { aspect-ratio: 1; }
  @media (hover: hover) and (min-width: 861px) {
    .crea__row:hover, .crea__row:focus-visible { grid-template-columns: 4rem minmax(0, 1.1fr) minmax(0, 1fr) 8rem; }
    .crea__row:hover .crea__name { transform: translateX(1rem); font-style: italic; }
  }
  @media (max-width: 860px), (hover: none) {
    .crea__row { grid-template-columns: 2rem minmax(0, 1fr) 4.5rem; gap: 0.4rem 0.9rem; }
    .crea__no { grid-row: 1; }
    .crea__name { font-size: clamp(1.8rem, 8.5vw, 2.8rem); }
    .crea__about { grid-column: 2; grid-row: 2; font-size: 0.9375rem; }
    .crea__thumb { grid-column: 3; grid-row: 1 / span 2; }
