---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Embed from '../components/Embed.astro';
import { site } from '../data/site';
import { byId } from '../data/collections';
import { posts, chronology, igPost, type Post } from '../data/posts';

const ivoire = byId('jellaba-ivoire');
const citron = byId('jellaba-citron');

/** The house's recurring details, each traced to the post where it appears. */
const details = [
  { term: 'Capuchon beldi', note: '« inspiré de la jelaba »', from: 'Kimono court en dentelle · 29 mars 2026', to: 'p-dentelle', draw: 'hood' },
  { term: 'Rangée de boutons noirs', note: 'du col à l’ourlet, poignets assortis', from: 'Jellaba sans capuche · 6 avril 2026', to: 'p-ivoire', draw: 'buttons' },
  { term: 'Finitions perlées', note: 'au décolleté croisé', from: 'Robe longue · 10 avril 2026', to: 'p-robe', draw: 'pearls' },
  { term: 'Bas à volants', note: '« pour un tombé impeccable »', from: 'Robe longue · 10 avril 2026', to: 'p-robe', draw: 'ruffle' },
  { term: 'Panneaux brodés', note: 'bleu nuit sur vert citron', from: 'Jellaba deux pièces · 6 avril 2026', to: 'p-citron', draw: 'panel' },
  { term: 'Liens à pompons', note: 'à l’encolure dégagée', from: 'Gandoura · 31 mars 2026', to: 'p-pompons', draw: 'tassel' },
] as const;

const q = (p: Post) => (p.lang === 'fr' ? `« ${p.caption} »` : `“${p.caption}”`);
const dm = site.instagram.dm;
---
<Base>
  <!-- HERO — saffron field (the colour of the house's April 2026 robe), the real KK lockup, the house's own caption.
       Drawing only: the hero never waits on Instagram. -->
  <section class="hero" data-hero aria-labelledby="hero-t">
    <div class="hero__stage">
      <p class="hero__ghost kk" aria-hidden="true"><span>K</span><span>K</span></p>
      <Plate piece={citron} uid="hero-c" bare class="hero__fig hero__fig--b" label="Croquis original d’après la jellaba deux pièces vert citron publiée le 6 avril 2026" />
      <Plate piece={ivoire} uid="hero-i" bare class="hero__fig hero__fig--a" label="Croquis original d’après la jellaba sans capuche ivoire à boutons noirs publiée le 6 avril 2026" />
    </div>
    <div class="hero__txt">
      <p class="hero__lockup" aria-label="Kuskusi Kouture">
        <span class="kk" aria-hidden="true"><span>K</span><span>K</span></span>
        <span class="hero__name" aria-hidden="true">Kuskusi Kouture</span>
      </p>
      <p class="kicker hero__kicker">Casablanca · prêt-à-porter marocain</p>
      <h1 id="hero-t">Une touche marocaine <em>dans chaque détail</em></h1>
      <p class="hero__src">Légende de la maison sur Instagram, printemps 2026.</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href="#creations">Découvrir les créations</a>
        <a class="link" href={dm} target="_blank" rel="noopener noreferrer">Contacter la maison<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
      </div>
    </div>
    <p class="hero__credit">Croquis d’après les deux jellabas publiées le 6 avril 2026. Les photographies de la maison suivent.</p>
  </section>

  <!-- 01 CRÉATIONS — the real pieces, immediately, as Instagram publishes them -->
  <section id="creations" class="cr" aria-labelledby="cr-t">
    <div class="wrap cr__grid">
      <div id="p-robe" class="cr__open">
        <header class="cr__head">
          <p class="kicker">01 — Printemps 2026 · Casablanca</p>
          <h2 id="cr-t">Les créations</h2>
          <p class="cr__lede">Les pièces telles que la maison les a publiées, avec ses propres mots. Chaque image est l’intégration officielle d’Instagram : rien n’est recadré, rien n’est hébergé ici.</p>
        </header>
        <article class="pc pc--robe" aria-labelledby="t-robe">
          <div class="cap">
            <p class="cap__n">01</p>
            <h3 id="t-robe" class="cap__t">{posts.robe.title}</h3>
            <p class="cap__d"><time datetime={posts.robe.iso}>{posts.robe.date}</time> · Casablanca</p>
            <blockquote class="cap__q cap__q--big" lang="fr"><p>{q(posts.robe)}</p></blockquote>
            <p class="cap__l">{posts.robe.look}</p>
          </div>
          <Embed post={posts.robe} />
        </article>
      </div>

      <div class="pc-pair">
        <p class="pc-pair__lbl">Deux jellabas, publiées le même jour</p>
        <article id="p-citron" class="pc pc--citron">
          <div class="cap cap--top">
            <p class="cap__n">02</p>
            <h3 class="cap__t">{posts.citron.title}</h3>
            <p class="cap__d"><time datetime={posts.citron.iso}>{posts.citron.date}</time> · Casablanca</p>
          </div>
          <Embed post={posts.citron} />
          <div class="cap">
            <blockquote class="cap__q" lang="fr"><p>{q(posts.citron)}</p></blockquote>
            <p class="cap__l">{posts.citron.look}</p>
          </div>
        </article>
        <article id="p-ivoire" class="pc pc--ivoire">
          <div class="cap cap--top">
            <p class="cap__n">03</p>
            <h3 class="cap__t">{posts.ivoire.title}</h3>
            <p class="cap__d"><time datetime={posts.ivoire.iso}>{posts.ivoire.date}</time> · Casablanca</p>
          </div>
          <Embed post={posts.ivoire} />
          <div class="cap">
            <blockquote class="cap__q" lang="fr"><p>{q(posts.ivoire)}</p></blockquote>
            <p class="cap__l">{posts.ivoire.look}</p>
          </div>
        </article>
      </div>

      <article id="p-doree" class="pc pc--doree">
        <div class="cap">
          <p class="cap__n">04</p>
          <h3 class="cap__t">{posts.doree.title}</h3>
          <p class="cap__d"><time datetime={posts.doree.iso}>{posts.doree.date}</time> · Casablanca</p>
          <blockquote class="cap__q cap__q--big" lang="fr"><p>{q(posts.doree)}</p></blockquote>
          <p class="cap__l">{posts.doree.look}</p>
        </div>
        <Embed post={posts.doree} />
      </article>

      <article id="p-dentelle" class="pc pc--dentelle">
        <Embed post={posts.dentelle} />
        <div class="cap">
          <p class="cap__n">05</p>
          <h3 class="cap__t">{posts.dentelle.title}</h3>
          <p class="cap__d"><time datetime={posts.dentelle.iso}>{posts.dentelle.date}</time> · Casablanca</p>
          <blockquote class="cap__q" lang="fr"><p>{q(posts.dentelle)}</p></blockquote>
          <p class="cap__l">{posts.dentelle.look}</p>
        </div>
      </article>

      <p class="cr__more">Toutes les publications : <a href={site.instagram.url} target="_blank" rel="noopener noreferrer">@{site.instagram.handle}<span class="sr-only"> sur Instagram (nouvel onglet)</span> ↗</a></p>
    </div>
  </section>

  <!-- 02 DÉTAILS — the vocabulary the house repeats, then three close looks -->
  <section id="details" class="de on-dark" aria-labelledby="de-t">
    <div class="wrap de__grid">
      <div class="de__side">
        <p class="kicker">02 — Détails & matières</p>
        <h2 id="de-t">Dans chaque <em>détail</em></h2>
        <p class="de__lede">« Notre touche marocaine », écrit la maison. Relevée dans ses publications, elle tient à quelques gestes précis, repris d’une pièce à l’autre.</p>
        <ol class="de__list">
          {details.map((d) => (
            <li>
              <svg class="de__ico" viewBox="0 0 80 80" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1">
                {d.draw === 'hood' && <path d="M14 66 C14 34 26 12 40 8 C54 12 66 34 66 66 M24 66 C26 44 32 30 40 26 C48 30 54 44 56 66" />}
                {d.draw === 'buttons' && <><path d="M30 6 V74 M50 6 V74" />{[12, 22, 32, 42, 52, 62].map((y) => <circle cx="40" cy={y} r="3" fill="currentColor" />)}</>}
                {d.draw === 'pearls' && <><path d="M16 10 L40 58 L64 10" />{[0, 1, 2, 3, 4, 5].map((k) => <><circle cx={19 + k * 3.8} cy={17 + k * 7.6} r="2" /><circle cx={61 - k * 3.8} cy={17 + k * 7.6} r="2" /></>)}</>}
                {d.draw === 'ruffle' && <path d="M8 30 H72 M8 30 L4 60 Q10 52 16 60 Q22 52 28 60 Q34 52 40 60 Q46 52 52 60 Q58 52 64 60 Q70 52 76 60 L72 30" />}
                {d.draw === 'panel' && <><rect x="20" y="10" width="40" height="60" /><path d="M40 14 L56 30 L40 46 L24 30 Z M40 34 L56 50 L40 66 L24 50 Z" /></>}
                {d.draw === 'tassel' && <path d="M40 4 V34 M40 34 C30 44 30 58 34 74 M40 34 C50 44 50 58 46 74 M40 34 V74 M36 34 H44" />}
              </svg>
              <div>
                <h3>{d.term}</h3>
                <p>{d.note}</p>
                <a href={`#${d.to}`}>{d.from}</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="de__wall">
        {([['tanyla', 'p-tanyla'], ['tanila', 'p-tanila'], ['pompons', 'p-pompons']] as const).map(([k, id], i) => {
          const p = posts[k];
          return (
            <article id={id} class:list={['dp', `dp--${i}`]}>
              <div class="cap cap--top">
                <h3 class="cap__t">{p.title}</h3>
                <p class="cap__d"><time datetime={p.iso}>{p.date}</time>{p.iso.startsWith('2026') && ' · Casablanca'}</p>
              </div>
              <Embed post={p} />
              <div class="cap">
                <blockquote class="cap__q" lang={p.lang}><p>{q(p)}</p></blockquote>
                {p.fr && <p class="cap__fr">Traduction proposée : « {p.fr} »</p>}
                <p class="cap__l">{p.look}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 03 LOOKBOOK — Ramadan 2024 in the riad salon, and the Resort film -->
  <section id="lookbook" class="lb on-dark" aria-labelledby="lb-t">
    <div class="wrap">
      <header class="lb__head">
        <p class="kicker">03 — Lookbook 2024</p>
        <h2 id="lb-t">Ramadan 2024, <em>au salon</em></h2>
        <p class="lb__lede">Avant les légendes en français, la maison écrivait en anglais et donnait des noms à ses pièces : Thairy, Tanyla, Nelya, Bad3ia Tanila. Banquettes de brocart, plafond de cèdre, tableau au cadre doré ; les commandes se prennent en message privé.</p>
      </header>
      <div class="lb__row">
        {(['thairy', 'kaki', 'resort'] as const).map((k, i) => {
          const p = posts[k];
          return (
            <article id={`p-${k}`} class:list={['lk', `lk--${i}`]}>
              <div class="cap cap--top">
                <p class="cap__n">{['Mars', 'Mars', 'Juillet'][i]} 2024</p>
                <h3 class="cap__t">{p.title}</h3>
                <p class="cap__d"><time datetime={p.iso}>{p.date}</time></p>
              </div>
              <Embed post={p} />
              <div class="cap">
                <blockquote class="cap__q" lang="en"><p>{q(p)}</p></blockquote>
                {p.fr && <p class="cap__fr">Traduction proposée : « {p.fr} »</p>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 04 LA MAISON — Casablanca, Marrakech, the pop-up, the public chronology -->
  <section id="maison" class="ma" aria-labelledby="ma-t">
    <div class="wrap ma__grid">
      <header class="ma__head">
        <p class="kicker">04 — La maison</p>
        <h2 id="ma-t">Casablanca, <em>Marrakech</em></h2>
        <blockquote class="ma__bio" lang="en">
          <p>“At Kuskusi Kouture, we blend simplicity with sophistication while honoring our Moroccan heritage.”</p>
        </blockquote>
        <p class="ma__bio-fr">Bio Instagram de la maison. Traduction proposée : « Chez Kuskusi Kouture, nous allions simplicité et sophistication, dans le respect de notre héritage marocain. »</p>
      </header>

      <article id="p-popup" class="ma__pop">
        <div class="cap cap--top">
          <p class="cap__n">18 & 19 avril 2026</p>
          <h3 class="cap__t">Spring Pop-Up, Mooon Studio</h3>
          <p class="cap__d">Publication de @mooonstudio_ · <time datetime={posts.popup.iso}>{posts.popup.date}</time></p>
        </div>
        <Embed post={posts.popup} />
      </article>

      <div class="ma__facts">
        <dl class="ma__dl">
          <div><dt>Casablanca</dt><dd>Les publications de 2026 sont géolocalisées à Casablanca.</dd></div>
          <div><dt>Marrakech</dt><dd>La bio Instagram épingle <a href={site.stockist.url} target="_blank" rel="noopener noreferrer">@{site.stockist.handle}<span class="sr-only"> (nouvel onglet)</span></a>, adresse de créateurs marocains dans la médina. Nature du lien à confirmer avec la maison.</dd></div>
          <div><dt>Pop-up</dt><dd>Mooon Studio, 123 rue Ibnou Majat, quartier des Princesses : la maison figure parmi les marques annoncées par <a href={igPost(posts.popup.code)} target="_blank" rel="noopener noreferrer">@mooonstudio_<span class="sr-only"> (nouvel onglet)</span></a> et par <a href={site.popup.press} target="_blank" rel="noopener noreferrer">MWN Lifestyle<span class="sr-only"> (nouvel onglet)</span></a> (16 avril 2026).</dd></div>
          <div><dt>Création</dt><dd>« Les nouveautés, modèles et créations de Zhor Kuskusi », selon la page Facebook de la maison. Nom de la créatrice à confirmer.</dd></div>
        </dl>
        <h3 class="ma__ch-t">Les collections, telles que publiées</h3>
        <ol class="ma__ch">
          {chronology.map((c) => (
            <li><span class="ma__when">{c.when}</span><strong>{c.what}</strong><span class="ma__note">{c.note}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 CONTACT — the house takes orders by Instagram DM -->
  <section id="contact" class="ct on-dark" aria-labelledby="ct-t">
    <div class="wrap ct__grid">
      <div class="ct__main">
        <p class="kicker">05 — Contact</p>
        <h2 id="ct-t">Contacter <em>la maison</em></h2>
        <p class="ct__lede">La maison prend les commandes en message privé, comme l’indiquent ses légendes :</p>
        <ul class="ct__quotes">
          <li lang="en">“Order yours via DM !” <span>17 mars 2024</span></li>
          <li lang="en">“Orders via DM. We deliver everywhere in Morocco.” <span>11 mars 2024</span></li>
        </ul>
        <div class="ct__ctas">
          <a class="btn btn--light btn--big ct__dm" href={dm} target="_blank" rel="noopener noreferrer">Écrire à @{site.instagram.handle}<span class="sr-only"> en message privé sur Instagram (nouvel onglet)</span></a>
          <a class="link" href={site.instagram.url} target="_blank" rel="noopener noreferrer">Voir le profil Instagram<span class="sr-only"> (nouvel onglet)</span></a>
          {site.facebook && <a class="link" href={site.facebook.url} target="_blank" rel="noopener noreferrer">Page Facebook · {site.facebook.name}<span class="sr-only"> (nouvel onglet)</span></a>}
        </div>
      </div>
      <ol class="ct__steps">
        <li><span>01</span><p><strong>Choisissez une pièce.</strong> Notez son nom ou la date de sa publication : « Robe longue, 10 avril 2026 ».</p></li>
        <li><span>02</span><p><strong>Écrivez en message privé</strong> à @{site.instagram.handle} sur Instagram.</p></li>
        <li><span>03</span><p><strong>Voyez avec la maison</strong> la taille, le coloris, le prix et la livraison : ils ne sont pas publiés ici.</p></li>
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ——— HERO ——— */
  .hero { position: relative; background: var(--safran); color: var(--encre); min-height: calc(100svh - var(--header-h) - 2rem); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; padding-inline: var(--gutter); overflow: hidden; isolation: isolate; }
  .hero__stage { grid-column: 2; grid-row: 1; position: relative; display: grid; place-items: end center; height: 100%; min-height: 34rem; }
  .hero__ghost { grid-area: 1 / 1; align-self: center; margin: 0; font-size: min(64vh, 40vw); color: #d4a100; line-height: 0.74; user-select: none; animation: kkIn 1.8s var(--ease) both; }
  :global(.hero__fig) { grid-area: 1 / 1; margin: 0; height: min(88%, 46rem); width: auto; aspect-ratio: 3 / 4; z-index: 1; }
  :global(.hero__fig--a) { animation: figIn 1.4s var(--ease) 0.15s both; }
  :global(.hero__fig--b) { height: min(64%, 34rem); transform: translateX(62%); align-self: end; margin-bottom: 3%; opacity: 0.96; animation: figInB 1.6s var(--ease) 0.4s both; }
  @keyframes kkIn { from { letter-spacing: 0.12em; opacity: 0; } }
  @keyframes figIn { from { opacity: 0; transform: translateY(18px); } }
  @keyframes figInB { from { opacity: 0; transform: translate(62%, 18px); } }
  .hero__txt { grid-column: 1; grid-row: 1; align-self: center; padding-block: 3rem 5rem; position: relative; z-index: 2; }
  .hero__lockup { display: inline-grid; justify-items: center; gap: 0.7rem; margin: 0 0 2.6rem; }
  .hero__lockup .kk { font-size: clamp(4.2rem, 7.2vw, 7rem); }
  .hero__name { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.5em; text-transform: uppercase; padding-left: 0.5em; white-space: nowrap; }
  .hero__kicker { margin: 0 0 1.1rem; }
  @media (max-width: 860px) { .hero__kicker { margin-bottom: 0.7rem; } }
  .hero h1 { font-size: clamp(2.6rem, 4.9vw, 5.1rem); line-height: 0.98; max-width: 10.5ch; letter-spacing: -0.03em; }
  .hero h1 em { display: block; }
  .hero__src { margin: 1.2rem 0 2.2rem; font-size: var(--fs-small); }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 2rem; }
  .hero__credit { position: absolute; left: var(--gutter); bottom: 1.4rem; margin: 0; font-size: var(--fs-micro); max-width: 26rem; z-index: 2; opacity: 0.85; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; align-items: start; min-height: 0; padding-bottom: 2.75rem; }
    .hero__stage { grid-column: 1; grid-row: 1; height: min(47svh, 30rem); min-height: 18rem; place-items: end center; margin-top: 0.5rem; }
    .hero__ghost { font-size: min(66vw, 24rem); align-self: end; margin-bottom: 6%; }
    :global(.hero__fig) { height: 100%; }
    :global(.hero__fig--b) { display: none; }
    .hero__txt { grid-row: 2; padding-block: 1.1rem 0; text-align: left; }
    .hero__lockup { display: none; }
    .hero h1 { font-size: clamp(2.1rem, 9.6vw, 3.2rem); max-width: none; }
    .hero h1 em { display: inline; }
    .hero__src { margin: 0.8rem 0 1.4rem; }
    .hero__cta { gap: 0.6rem 1.5rem; }
    .hero__cta .btn { flex: 1 1 100%; }
    .hero__credit { position: static; grid-row: 3; text-align: left; margin-top: 1.4rem; max-width: none; }
  }

  /* ——— shared caption ——— */
  .cap { max-width: 30rem; }
  .cap__n { font: 400 0.8125rem/1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 0.9rem; }
  .cap__t { font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1.02; }
  .cap__d { margin: 0.55rem 0 0; font-size: var(--fs-small); letter-spacing: 0.02em; opacity: 0.85; }
  .cap--top { margin-bottom: 1.1rem; }
  .cap__q { margin: 1.3rem 0 0; padding: 0 0 0 1rem; border-left: 1px solid currentColor; font-family: var(--serif); font-style: italic; font-size: clamp(1.1rem, 1.45vw, 1.3rem); line-height: 1.38; font-variation-settings: 'opsz' 28; }
  .cap__q p { margin: 0; }
  .cap__q--big { font-size: clamp(1.35rem, 2.2vw, 2rem); line-height: 1.22; }
  .cap__fr { margin: 0.7rem 0 0; font-size: var(--fs-small); opacity: 0.85; }
  .cap__l { margin: 0.9rem 0 0; font-size: var(--fs-small); opacity: 0.85; }

  /* ——— 01 CRÉATIONS ——— */
  .cr { background: var(--chaux); padding-block: clamp(4rem, 8vw, 8rem) clamp(4rem, 8vw, 7rem); }
  .cr__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.2vw, 2rem); row-gap: clamp(4rem, 9vw, 9rem); max-width: 1440px; }
  .cr__open { grid-column: 1 / -1; }
  .cr__head h2 { font-size: var(--fs-1); margin-top: 1.2rem; }
  .cr__lede { margin-top: 1.4rem; max-width: 27rem; color: var(--encre-2); }
  .pc { display: grid; gap: 1.5rem; }
  @media (min-width: 1001px) {
    .cr__open { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: inherit; }
    .cr__head { grid-column: 1 / 6; grid-row: 1; }
    .pc--robe { display: contents; }
    .pc--robe .cap { grid-column: 1 / 6; grid-row: 2; align-self: end; max-width: 27rem; padding-top: 3rem; }
    .pc--robe :global(.ig) { grid-column: 7 / 13; grid-row: 1 / span 2; justify-self: end; }
    .cr__head { align-self: start; }
  }
  .pc-pair { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: inherit; position: relative; }
  .pc-pair__lbl { grid-column: 1 / -1; margin: 0 0 2rem; font: 600 var(--fs-micro)/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 1rem; }
  .pc-pair__lbl::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .pc--citron { grid-column: 1 / 6; }
  .pc--ivoire { grid-column: 8 / 13; margin-top: clamp(4rem, 14vw, 14rem); }
  .pc--doree { grid-column: 2 / 12; grid-template-columns: minmax(0, 1fr) minmax(0, 540px); align-items: center; column-gap: clamp(2rem, 6vw, 6rem); }
  .pc--doree .cap { max-width: 26rem; justify-self: end; }
  .pc--dentelle { grid-column: 4 / 12; grid-template-columns: minmax(0, 470px) minmax(0, 1fr); align-items: start; column-gap: 2.5rem; }
  .pc--dentelle .cap { padding-top: 6rem; }
  .cr__more { grid-column: 1 / -1; margin: 0; text-align: center; font-size: var(--fs-small); }
  .cr__more a { display: inline-flex; min-height: 44px; align-items: center; }
  @media (max-width: 1000px) {
    .cr__grid { row-gap: 4.5rem; }
    .cr__open { display: grid; gap: 3.5rem; }
