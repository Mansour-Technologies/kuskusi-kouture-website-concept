---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { pieces, chapters, details, byId, igEmbed, igPost } from '../data/collections';

const hero = [byId('robe-rose'), byId('robe-safran'), byId('jellaba-citron')];
const nuancier = ['robe-safran', 'jellaba-citron', 'robe-rose', 'jellaba-ivoire', 'gandoura-doree', 'bomber-menthe'].map(byId);
const nuancierLabel: Record<string, string> = {
  'robe-safran': 'Safran', 'jellaba-citron': 'Vert citron', 'robe-rose': 'Rose dragée',
  'jellaba-ivoire': 'Ivoire & noir', 'gandoura-doree': 'Or pâle', 'bomber-menthe': 'Menthe',
};
const onInsta = [byId('jellaba-ivoire'), byId('kimono-dentelle'), byId('gandoura-doree')];
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : null;
---
<Base>
  <!-- HERO — a riad arcade: three real pieces, drawn, under the house's own caption line -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <p class="kicker hero__kicker wrap">Casablanca <span aria-hidden="true">·</span> Mode marocaine moderne<span class="hide-sm"> <span aria-hidden="true">·</span> @{site.instagram.handle}</span></p>
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">Kuskusi Kouture — </span>
      <span class="hero__l1">Une touche marocaine</span>
      <em class="hero__l2"><span>dans chaque détail.</span></em>
    </h1>
    <div class="hero__arcade">
      {hero.map((p, i) => (
        <div class:list={['arch', `arch--${i}`]}>
          <button type="button" class="arch__btn" data-fiche={p.id} aria-label={`Voir la pièce : ${p.name} (publication du ${p.date})`}>
            <Plate piece={p} uid={`h${i}`} />
          </button>
          <p class="arch__cap"><span class="arch__name">{p.name.split(' — ')[0]}</span> <a href={igPost(p.code)} target="_blank" rel="noopener noreferrer">Voir la photo officielle<br />sur Instagram<span aria-hidden="true"> ↗</span><span class="sr-only"> : {p.name} (nouvel onglet)</span></a></p>
        </div>
      ))}
    </div>
    <div class="hero__foot wrap">
      <p class="hero__src small">« Une touche marocaine dans chaque détail » — légende des publications @{site.instagram.handle}. Dessins originaux d’après trois pièces publiées en avril 2026 : touchez une arche pour voir la photo officielle.</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">Écrire à la maison<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
        <a class="link" href="#vestiaire">Le vestiaire</a>
      </div>
    </div>
  </section>

  <!-- NUANCIER — the season's real colours, each one a piece -->
  <section class="nu" aria-labelledby="nu-title">
    <h2 id="nu-title" class="sr-only">Le nuancier de la saison</h2>
    <ol class="nu__list">
      {nuancier.map((p) => (
        <li style={`--c:${p.colors[0]};--d:${p.id === 'jellaba-ivoire' ? '#151515' : p.colors[1]}`}>
          <button type="button" data-fiche={p.id}>
            <span class="nu__name serif">{nuancierLabel[p.id]}</span>
            <span class="nu__piece small">{p.name.split(' — ')[0]}</span>
          </button>
        </li>
      ))}
    </ol>
  </section>

  <!-- 01 LA MAISON -->
  <section id="maison" class="ma wrap" aria-labelledby="ma-title">
    <p class="kicker num rv">01 — La maison</p>
    <div class="ma__grid">
      <div class="ma__quote rv">
        <h2 id="ma-title"><em>Simplicity</em> with sophistication.</h2>
        <blockquote>
          <p lang="en">“{site.bio}”</p>
          <footer class="small muted">— bio Instagram de @{site.instagram.handle}. En français : « allier simplicité et sophistication, en honorant notre héritage marocain » (traduction proposée).</footer>
        </blockquote>
        <p class="measure ma__lede">Pas de caftan de cérémonie surchargé : des pièces du quotidien — jellabas légères, kimonos, gandouras, robes longues, et même une veste bomber — où la touche marocaine tient dans un détail. Un capuchon beldi, une rangée de boutons, des liens à pompons.</p>
      </div>
      <dl class="ma__facts rv">
        <div><dt class="kicker">Ville</dt><dd>Casablanca <span class="muted small">— lieu indiqué sur les publications</span></dd></div>
        <div><dt class="kicker">À trouver</dt><dd><a href={site.stockist.url} target="_blank" rel="noopener noreferrer">{site.stockist.name}</a>, médina de {site.stockist.city} <span class="muted small">— adresse épinglée dans la bio Instagram</span></dd></div>
        <div><dt class="kicker">Rendez-vous</dt><dd><a href={site.popup.post} target="_blank" rel="noopener noreferrer">Spring Pop-Up, Mooon Studio</a>, Casablanca — {site.popup.dates} <span class="muted small">(<a href={site.popup.press} target="_blank" rel="noopener noreferrer">MWN Lifestyle</a>)</span></dd></div>
        <div><dt class="kicker">Vestiaire</dt><dd>Jellabas, kimonos, gandouras, robes, vestes — et une sélection <em>Kids</em> <span class="muted small">(story à la une)</span></dd></div>
        <div><dt class="kicker">Création</dt><dd>{site.designer} <span class="muted small">— selon la page Facebook « Kuskusi Zhor Kouture », à confirmer par la maison</span></dd></div>
        <div><dt class="kicker">Voix</dt><dd>Légendes en français, hashtags <span lang="en">#MoroccanHeritage #MadeInMorocco #ModernMoroccan</span></dd></div>
      </dl>
    </div>
  </section>

  <hr class="zrule" />

  <!-- 02 LE VESTIAIRE -->
  <section id="vestiaire" class="ve" aria-labelledby="ve-title">
    <div class="wrap ve__head">
      <p class="kicker num rv">02 — Le vestiaire</p>
      <h2 id="ve-title" class="rv">Douze pièces, <em>telles que publiées</em> au printemps 2026.</h2>
      <p class="measure muted rv">Chaque arche est un dessin original d’après une publication officielle de @{site.instagram.handle} : même couleur, même coupe, même détail, même décor. Touchez une pièce pour lire la légende de la maison et afficher la photo officielle.</p>
    </div>
    {chapters.map((c, ci) => {
      const list = pieces.filter((p) => p.chapter === c.id);
      return (
        <div class="ch" id={`ch-${c.id}`}>
          <div class="wrap ch__head rv">
            <h3>{c.title}</h3>
            <p class="kicker muted">{c.kicker} · {list.length} pièces</p>
          </div>
          <ul class="rail" aria-label={c.title}>
            {list.map((p, i) => (
              <li class="card">
                <button type="button" data-fiche={p.id} data-lb aria-label={`Voir la pièce : ${p.name}`}>
                  <Plate piece={p} uid={`v${ci}${i}`} />
                </button>
                <p class="card__name">{p.name}</p>
                <p class="card__date small muted">Instagram · {p.date} — <a href={igPost(p.code)} target="_blank" rel="noopener noreferrer">Voir la photo officielle sur Instagram<span aria-hidden="true"> ↗</span><span class="sr-only"> : {p.name} (nouvel onglet)</span></a></p>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>

  <!-- 03 LE DÉTAIL -->
  <section id="detail" class="de on-dark" aria-labelledby="de-title">
    <div class="wrap">
      <p class="kicker num rv">03 — Le détail</p>
      <h2 id="de-title" class="rv">La touche marocaine, <em>détail par détail.</em></h2>
      <p class="measure de__lede rv">« Notre touche marocaine », écrit la maison. La voici, relevée pièce par pièce dans ses propres publications.</p>
      <ol class="de__list">
        {details.map((d, i) => (
          <li class="rv">
            <svg class="de__ico" viewBox="0 0 80 80" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="0.9">
              {d.draw === 'hood' && <path d="M14 66 C14 34 26 12 40 8 C54 12 66 34 66 66 M24 66 C26 44 32 30 40 26 C48 30 54 44 56 66" />}
              {d.draw === 'buttons' && <><path d="M30 6 V74 M50 6 V74" />{[12, 22, 32, 42, 52, 62].map((y) => <circle cx="40" cy={y} r="3" fill="currentColor" />)}</>}
              {d.draw === 'pearls' && <><path d="M16 10 L40 58 L64 10" />{[0, 1, 2, 3, 4, 5].map((k) => <><circle cx={19 + k * 3.8} cy={17 + k * 7.6} r="2" /><circle cx={61 - k * 3.8} cy={17 + k * 7.6} r="2" /></>)}</>}
              {d.draw === 'ruffle' && <path d="M8 30 H72 M8 30 L4 60 Q10 52 16 60 Q22 52 28 60 Q34 52 40 60 Q46 52 52 60 Q58 52 64 60 Q70 52 76 60 L72 30" />}
              {d.draw === 'panel' && <><rect x="20" y="10" width="40" height="60" /><path d="M40 14 L56 30 L40 46 L24 30 Z M40 34 L56 50 L40 66 L24 50 Z" /></>}
              {d.draw === 'tassel' && <path d="M40 4 V34 M40 34 C30 44 30 58 34 74 M40 34 C50 44 50 58 46 74 M40 34 V74 M36 34 H44" />}
            </svg>
            <span class="de__n kicker">{String(i + 1).padStart(2, '0')}</span>
            <h3>{d.term}</h3>
            <p class="small de__from">{d.note}<br />Sur : <button type="button" class="de__link" data-fiche={d.piece}>{d.from}</button></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 SUR INSTAGRAM — official embeds, click-to-load -->
  <section id="instagram" class="ig wrap" aria-labelledby="ig-title">
    <p class="kicker num rv">04 — Sur Instagram</p>
    <div class="ig__head">
      <h2 id="ig-title" class="rv">Les vraies photos, <em>chez la maison.</em></h2>
      <p class="measure muted rv">Les photographies appartiennent à Kuskusi Kouture : elles ne sont pas copiées ici. Chaque cadre charge la publication officielle depuis Instagram, seulement si vous le demandez.</p>
    </div>
    <ul class="ig__grid">
      {onInsta.map((p, i) => (
        <li class="ig__item rv" data-embed-box>
          <div class="ig__poster">
            <Plate piece={p} uid={`ig${i}`} />
            <button type="button" class="ig__load" data-embed={igEmbed(p.code)} data-title={`Publication Instagram officielle : ${p.name}`}>
              <span class="kicker">Instagram · {p.date}</span>
              <span class="serif ig__cta">Afficher la publication officielle</span>
              <span class="small">Chargement depuis instagram.com</span>
            </button>
          </div>
          <p class="ig__cap"><span class="serif">« {p.caption} »</span> <a class="small" href={igPost(p.code)} target="_blank" rel="noopener noreferrer">Voir sur Instagram<span class="sr-only"> : {p.name} (nouvel onglet)</span></a></p>
        </li>
      ))}
    </ul>
    <p class="ig__more rv"><a class="btn" href={site.instagram.url} target="_blank" rel="noopener noreferrer">Tout le vestiaire sur @{site.instagram.handle}<span class="sr-only"> (nouvel onglet)</span></a></p>
  </section>

  <!-- 05 ÉCRIRE -->
  <section id="contact" class="ct" aria-labelledby="ct-title">
    <div class="wrap ct__grid">
      <div class="ct__intro">
        <p class="kicker num rv">05 — Écrire à la maison</p>
        <h2 id="ct-title" class="rv">Une pièce vous plaît ? <em class="nowrap">Écrivez-lui.</em></h2>
        <p class="measure muted rv">La maison publie et répond sur Instagram. Donnez le nom de la pièce et la date de la publication : c’est le plus simple pour se comprendre.</p>
      </div>
      <ol class="ct__steps">
          <li class="rv"><span class="kicker">01</span><strong class="serif">Repérer</strong><span class="small muted">Une pièce du vestiaire ou du compte Instagram.</span></li>
          <li class="rv"><span class="kicker">02</span><strong class="serif">Écrire</strong><span class="small muted">En message direct, avec le nom de la pièce.</span></li>
          <li class="rv"><span class="kicker">03</span><strong class="serif">Échanger</strong><span class="small muted">Taille, couleur, délai, retrait à Casablanca ou chez House of Chiki : à voir avec la maison.</span></li>
        </ol>
      <div class="ct__side">
        <a class="ct__dm rv" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">
          <span class="kicker">Message direct Instagram</span>
          <span class="ct__handle serif"><span class="ct__at">@</span>{site.instagram.handle}</span>
          <span class="ct__go" aria-hidden="true">Écrire →</span>
          <span class="sr-only">(nouvel onglet)</span>
        </a>
        <div class="ct__alt">
          <a class="btn" href={site.instagram.url} target="_blank" rel="noopener noreferrer">Voir le profil<span class="sr-only"> Instagram (nouvel onglet)</span></a>
          {wa && <a class="btn" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (nouvel onglet)</span></a>}
          {site.facebook && <a class="btn" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook<span class="sr-only"> (nouvel onglet)</span></a>}
        </div>
        <figure class="ct__ex rv">
          <figcaption class="kicker">Exemple de message (proposé)</figcaption>
          <p>Bonjour Kuskusi Kouture ! La <em>Jellaba deux pièces vert citron</em> (publication du 5 avril) existe-t-elle en taille M ? Merci 🤍</p>
        </figure>
      </div>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .num { color: var(--encre-2); margin-bottom: 1.5rem; }

  /* ——— HERO ——— */
  .hero { position: relative; padding-top: clamp(1.25rem, 3vw, 2.5rem); overflow: clip; display: flex; flex-direction: column; }
  .hero__kicker { order: 0; } .hero__l1 { order: 1; } .hero__arcade { order: 2; } .hero__l2 { order: 3; } .hero__foot { order: 4; }
  .hero__kicker { text-align: center; color: var(--encre-2); margin: 0 auto clamp(0.75rem, 2vw, 1.5rem); }
  .hero__title { display: contents; }
  .hero__l1, .hero__l2 { text-align: center; padding-inline: var(--gutter); position: relative; z-index: 2; font-family: var(--serif); font-weight: 400; font-variation-settings: 'opsz' 96; }
  .hero__l1 { display: block; font-size: clamp(2.7rem, min(7vw, 11vh), 7rem); line-height: 0.95; letter-spacing: -0.035em; }
  .hero__l2 { display: block; font-size: clamp(2.4rem, min(6vw, 9.5vh), 6rem); line-height: 1; letter-spacing: -0.03em; position: relative; z-index: 3; margin-top: 0.05em; color: var(--encre); }
  .hero__arcade { position: relative; display: grid; grid-template-columns: 1fr 1.35fr 1fr; align-items: end; gap: clamp(0.75rem, 2.2vw, 2.5rem); width: min(100% - 2 * var(--gutter), 780px, 74vh); margin: clamp(1rem, 2.5vw, 2rem) auto 0; }
  .arch { position: relative; z-index: 1; }
  .arch__btn { display: block; width: 100%; padding: 0; border: 0; background: none; transition: transform 0.7s var(--ease); }
  .arch__btn:hover { transform: translateY(-6px); }
  .arch__cap { margin: 0.7rem 0 0; text-align: center; font-size: var(--fs-small); line-height: 1.35; display: grid; justify-items: center; }
  .arch__name { font-family: var(--serif); font-style: italic; font-size: 1.05rem; font-variation-settings: 'opsz' 28; }
  .arch__cap a { font-size: 0.625rem; line-height: 1.5; letter-spacing: 0.14em; padding-block: 0.3rem; text-transform: uppercase; color: var(--encre-2); min-height: 44px; display: inline-flex; align-items: center; text-underline-offset: 0.3em; }
  .arch--0, .arch--2 { margin-bottom: clamp(2.5rem, 7vw, 6rem); }
  .hero__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem); position: relative; z-index: 2; }
  .hero__src { margin: 0; max-width: 40rem; color: var(--encre-2); }
  .hero__cta { display: flex; align-items: center; gap: 1.5rem; }

  .js .arch { animation: archIn 1.2s var(--ease) both; }
  .js .arch--1 { animation-delay: 0.1s; } .js .arch--0 { animation-delay: 0.28s; } .js .arch--2 { animation-delay: 0.4s; }
  @keyframes archIn { from { clip-path: inset(100% 0 0 0); transform: translateY(40px); } to { clip-path: inset(0); transform: none; } }

  @media (max-width: 700px) {
    .hero__arcade { grid-template-columns: 1fr 2.2fr 1fr; width: calc(100% + 30vw); margin-left: -15vw; gap: 0.75rem; }
    .arch--0, .arch--2 { margin-bottom: 4.5rem; }
    .arch--0 .arch__cap, .arch--2 .arch__cap { visibility: hidden; }
    .hide-sm { display: none; }
    .hero__foot { flex-direction: column-reverse; align-items: stretch; text-align: center; padding-top: 1.25rem; }
    .hero__cta { flex-direction: column; gap: 0.5rem; }
    .hero__cta .btn { width: 100%; }
  }

  /* ——— NUANCIER ——— */
  .nu__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); }
  .nu__list li { background: var(--c); color: #1a1a1a; transition: flex 0.5s; }
  .nu__list button { width: 100%; min-height: clamp(7rem, 13vw, 11rem); padding: 1rem; border: 0; background: linear-gradient(to top, color-mix(in srgb, var(--d) 30%, transparent), transparent 60%); display: flex; flex-direction: column; justify-content: flex-end; gap: 0.2rem; text-align: left; transition: background-size 0.4s; }
  .nu__list button:hover .nu__name { font-style: italic; }
  .nu__name { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.05; }
  .nu__piece { opacity: 0.8; }
  @media (max-width: 760px) { .nu__list { grid-template-columns: repeat(3, 1fr); } .nu__list button { min-height: 6.5rem; padding: 0.75rem; } }

  /* ——— MAISON ——— */
  .ma { padding-block: clamp(4rem, 9vw, 8rem); }
  .ma__grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .ma__quote h2 { font-size: var(--fs-1); margin-bottom: 1.5rem; }
  .ma__quote blockquote { margin: 0 0 2rem; }
  .ma__quote blockquote p { font-family: var(--serif); font-size: var(--fs-3); line-height: 1.3; font-style: italic; margin-bottom: 0.6rem; font-variation-settings: 'opsz' 28; }
  .ma__lede { font-size: 1.125rem; }
  .ma__facts { margin: 0; border-top: 1px solid var(--line); }
  .ma__facts > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .ma__facts dt { padding-top: 0.3rem; color: var(--encre-2); }
  .ma__facts dd { margin: 0; }
  .ma__facts a { text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  @media (max-width: 900px) { .ma__grid { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .ma__facts > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  /* ——— VESTIAIRE ——— */
  .ve { padding-block: clamp(4rem, 8vw, 7rem) clamp(2rem, 4vw, 3rem); }
  .ve__head { display: grid; grid-template-columns: 1.5fr 1fr; column-gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .ve__head .num { grid-column: 1 / -1; }
  .ve__head h2 { font-size: var(--fs-1); max-width: 15ch; }
  .ve__head p.measure { margin: 0; }
  @media (max-width: 900px) { .ve__head { grid-template-columns: 1fr; } .ve__head h2 { margin-bottom: 1.25rem; } }
  .ch { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .ch__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; margin-bottom: 1.5rem; }
  .ch__head h3 { font-size: var(--fs-2); }
  .ch__head p { margin: 0; }
  .rail { list-style: none; margin: 0; padding: 0 var(--gutter) 1rem; display: grid; grid-auto-flow: column; grid-auto-columns: clamp(15rem, 23vw, 22rem); gap: clamp(1rem, 2.4vw, 2.25rem); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: thin; max-width: var(--max); margin-inline: auto; }
  .rail { position: relative; }
  .card { scroll-snap-align: start; position: relative; }
  .card:nth-child(even) { margin-top: clamp(1.5rem, 4vw, 3.5rem); }
  .card button { display: block; width: 100%; padding: 0; border: 0; background: none; transition: transform 0.6s var(--ease); }
  .card button:hover { transform: translateY(-6px); }
  .card__name { font-family: var(--serif); font-size: 1.25rem; line-height: 1.2; margin: 0.9rem 0 0.2rem; font-variation-settings: 'opsz' 28; }
  .card__date { margin: 0; }
  .card__date a { color: var(--encre); display: inline-flex; min-height: 44px; align-items: center; }
  @media (max-width: 700px) { .rail { grid-auto-columns: 68vw; } }
  @media (min-width: 1000px) {
    .ch { display: grid; grid-template-columns: minmax(14rem, 1fr) 3fr; max-width: var(--max); margin-inline: auto; padding-inline: var(--gutter); gap: 2rem; align-items: start; }
    .ch__head { display: block; border: 0; border-top: 1px solid var(--line); padding: 1rem 0 0; margin: 0; position: sticky; top: calc(var(--header-h) + 1.5rem); }
    .ch__head h3 { margin-bottom: 0.6rem; }
    .rail { padding: 0 0 1rem; margin: 0; max-width: none; grid-auto-columns: calc((100% - 2 * 2.25rem) / 3); scroll-padding-inline: 0; }
    .ch .wrap { padding-inline: 0; }
  }

  /* ——— DÉTAIL ——— */
  .de { background: var(--velours); color: var(--blanc); padding-block: clamp(4.5rem, 9vw, 8rem); }
  .de .num { color: #e5c9cc; }
  .de h2 { font-size: var(--fs-1); max-width: 14ch; }
  .de__lede { color: #ecd9db; margin: 1.5rem 0 3rem; font-size: 1.125rem; }
  .de__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgb(251 248 243 / 0.22); }
  .de__list li { position: relative; padding: 2rem 2rem 2rem 0; border-bottom: 1px solid rgb(251 248 243 / 0.22); display: grid; grid-template-columns: 4.5rem 1fr; column-gap: 1.25rem; align-items: start; }
  .de__list li:not(:nth-child(3n)) { border-right: 1px solid rgb(251 248 243 / 0.22); }
  .de__list li:not(:nth-child(3n + 1)) { padding-left: 2rem; }
