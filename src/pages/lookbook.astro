---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { url } from '../lib/url';

type L = { s: 'kaftan' | 'djellaba' | 'gandoura' | 'tenue'; c: string; shot: string; crop?: 'full' | 'detail' | 'back' | 'motion' };
const looks: L[] = [
  { s: 'kaftan', c: 'vert', shot: 'plan large, kaftan vert dans une cour blanche, silhouette centrée, beaucoup d’air' },
  { s: 'kaftan', c: 'pois', shot: 'pied, kaftan à pois contre un mur noir, flash direct' },
  { s: 'kaftan', c: 'pois', crop: 'detail', shot: 'macro sur les boutons et le motif à pois' },
  { s: 'djellaba', c: 'eau', crop: 'motion', shot: 'djellaba vert d’eau en marche, pose longue' },
  { s: 'gandoura', c: 'blanc', shot: 'gandoura blanche sur fond vert bouteille' },
  { s: 'tenue', c: 'brique', shot: 'tenue brique, assise sur un banc de pierre' },
  { s: 'djellaba', c: 'noir', crop: 'back', shot: 'djellaba noire de dos, capuche, lumière rasante' },
  { s: 'tenue', c: 'pois', shot: 'ensemble noir & blanc, cadrage mi-corps' },
  { s: 'kaftan', c: 'nuit', crop: 'detail', shot: 'détail de manche, kaftan bleu nuit, lumière de soirée' },
  { s: 'gandoura', c: 'eau', crop: 'motion', shot: 'gandoura vert d’eau au vent, terrasse' },
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title="Lookbook" current="lookbook/" description="Lookbook — chapitre proposé. Direction artistique de démonstration pour Kuskusi Kouture (concept non officiel).">
  <header class="wrap lb-cover">
    <p class="kicker">Lookbook · Chapitre I — proposition</p>
    <h1 class="lb-title">Vert, blanc<br /><em>&amp; pois.</em></h1>
    <p class="lb-sub muted measure">Un chapitre imaginé à partir des couleurs observées dans les créations publiques de la maison. Direction artistique proposée — les photographies seront réalisées avec la maison ; chaque emplacement décrit la prise de vue envisagée.</p>
  </header>

  <figure class="lb-full rv">
    <Plate silhouette={looks[0].s} colour={looks[0].c} shot={looks[0].shot} caption="none" uid="lb0" numeral="I" />
    <figcaption class="wrap lb-cap"><span class="kicker">Look 01</span> Photo à venir — {looks[0].shot}.</figcaption>
  </figure>

  <section class="wrap lb-pair" aria-label="Looks 02 et 03">
    <figure class="lb-a rv">
      <Plate silhouette={looks[1].s} colour={looks[1].c} shot={looks[1].shot} caption="none" uid="lb1" numeral="02" />
      <figcaption class="lb-cap"><span class="kicker">Look 02</span> Photo à venir — {looks[1].shot}.</figcaption>
    </figure>
    <figure class="lb-b rv">
      <Plate silhouette={looks[2].s} colour={looks[2].c} crop="detail" shot={looks[2].shot} caption="none" uid="lb2" />
      <figcaption class="lb-cap"><span class="kicker">Look 03</span> Photo à venir — {looks[2].shot}.</figcaption>
    </figure>
    <p class="lb-note serif rv">Le pois, motif de la ville, posé sur la ligne d’un vêtement de cérémonie.</p>
  </section>

  <section class="lb-inter" aria-label="Interlude">
    <p class="lb-word serif" aria-hidden="true"><em>Kouture</em></p>
    <p class="wrap lb-inter__t small muted">Interlude typographique — rythme de lecture entre deux séquences d’images.</p>
  </section>

  <section class="wrap lb-tri" aria-label="Looks 04 à 06">
    {[3, 4, 5].map((i, k) => (
      <figure class:list={['rv', `lb-t${k}`]}>
        <Plate silhouette={looks[i].s} colour={looks[i].c} crop={looks[i].crop} shot={looks[i].shot} caption="none" uid={`lb${i}`} numeral={n(i)} />
        <figcaption class="lb-cap"><span class="kicker">Look {n(i)}</span> Photo à venir — {looks[i].shot}.</figcaption>
      </figure>
    ))}
  </section>

  <section class="lb-contact" aria-labelledby="contact-title">
    <div class="wrap lb-contact__h">
      <h2 id="contact-title" class="serif">Planche <em>contact</em></h2>
      <p class="small muted">Faites défiler horizontalement.</p>
    </div>
    <ul class="lb-strip" tabindex="0" aria-label="Planche contact, looks 07 à 10">
      {[6, 7, 8, 9].map((i) => (
        <li>
          <Plate silhouette={looks[i].s} colour={looks[i].c} crop={looks[i].crop} shot={looks[i].shot} caption="none" uid={`lb${i}`} numeral={n(i)} />
          <p class="lb-cap"><span class="kicker">Look {n(i)}</span> Photo à venir — {looks[i].shot}.</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="lb-end on-dark">
    <div class="wrap">
      <p class="kicker">Fin du chapitre I</p>
      <p class="lb-end__t serif">Chaque look est une invitation. <em>Chaque invitation, un message.</em></p>
      <a class="btn btn--light" href={`${url()}#collections`}>Voir les collections</a>
    </div>
  </section>
</Base>

<style>
  .lb-cover { padding-block: clamp(3rem, 9vw, 8rem) clamp(2.5rem, 6vw, 5rem); }
  .lb-title { font-size: clamp(3.8rem, 13vw, 13rem); line-height: 0.86; margin: 1.2rem 0 2rem; letter-spacing: -0.04em; }
  .lb-cap { font-size: var(--fs-small); color: var(--ink-2); margin: 0.75rem 0 0; max-width: 40rem; }
  .lb-cap .kicker { color: var(--ink); margin-right: 0.5rem; }
  .lb-cap a { color: var(--ink); white-space: nowrap; display: inline-flex; min-height: 44px; align-items: center; }
  .lb-full { margin: 0; }
  .lb-full :global(.plate) { aspect-ratio: 16 / 8; }
  .lb-pair { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); margin-top: clamp(4rem, 9vw, 8rem); align-items: start; }
  .lb-pair figure { margin: 0; }
  .lb-a { grid-column: 1 / span 6; }
  .lb-b { grid-column: 8 / span 4; margin-top: 40% !important; }
  .lb-b :global(.plate) { aspect-ratio: 1; }
  .lb-note { grid-column: 8 / span 5; font-size: var(--fs-3); line-height: 1.25; margin-top: -2rem; }
  .lb-inter { margin-block: clamp(5rem, 10vw, 9rem); overflow: hidden; }
  .lb-word { font-size: clamp(6rem, 30vw, 30rem); line-height: 0.8; margin: 0; white-space: nowrap; text-align: center; color: var(--bottle); letter-spacing: -0.05em; }
  .lb-inter__t { text-align: center; margin-top: 1rem; }
  .lb-tri { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: end; }
  .lb-tri figure { margin: 0; }
  .lb-t0 { grid-column: 1 / span 3; }
  .lb-t1 { grid-column: 4 / span 5; }
  .lb-t1 :global(.plate) { aspect-ratio: 2 / 3; }
  .lb-t2 { grid-column: 9 / span 4; align-self: start; }
  .lb-contact { margin-top: clamp(5rem, 10vw, 9rem); }
  .lb-contact__h { display: flex; justify-content: space-between; align-items: end; margin-bottom: 1.5rem; gap: 1rem; }
  .lb-contact__h h2 { font-size: var(--fs-2); }
  .lb-strip { list-style: none; margin: 0; padding: 0 var(--gutter) 1rem; display: grid; grid-auto-flow: column; grid-auto-columns: clamp(16rem, 30vw, 28rem); gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; }
  .lb-strip li { scroll-snap-align: start; }
  .lb-end { background: var(--ink); color: var(--embroidery); padding-block: clamp(5rem, 12vw, 10rem); margin-top: clamp(5rem, 10vw, 9rem); }
  .lb-end__t { font-size: var(--fs-1); line-height: 1; max-width: 16ch; margin: 1.25rem 0 2.5rem; }
  @media (max-width: 860px) {
    .lb-full :global(.plate) { aspect-ratio: 4 / 5; }
    .lb-pair, .lb-tri { grid-template-columns: 1fr 1fr; gap: 2rem 0.75rem; }
    .lb-a { grid-column: 1 / -1; }
    .lb-b { grid-column: 2; margin-top: 0 !important; }
    .lb-note { grid-column: 1; grid-row: 2; margin: 0; align-self: center; font-size: 1.25rem; }
    .lb-t0 { grid-column: 1; } .lb-t1 { grid-column: 1 / -1; grid-row: 1; } .lb-t2 { grid-column: 2; }
    .lb-strip { grid-auto-columns: 74vw; }
  }
</style>
