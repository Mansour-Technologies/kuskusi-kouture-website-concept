---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import PieceCard from '../../components/PieceCard.astro';
import { pieces, lineBySlug, colours, sizes, related, type Piece } from '../../data/pieces';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return pieces.map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece } = Astro.props as { piece: Piece };
const line = lineBySlug(piece.line);
const rel = related(piece);
const guide = [
  ['36', '82–85', '64–67', '90–93'],
  ['38', '86–89', '68–71', '94–97'],
  ['40', '90–93', '72–75', '98–101'],
  ['42', '94–97', '76–79', '102–105'],
  ['44', '98–102', '80–84', '106–110'],
  ['46', '103–107', '85–89', '111–115'],
];
---
<Base title={`${line.singular} — Étude n°${piece.no}`} current="collections/" description={`${piece.title} — pièce de démonstration (${line.singular}). Concept de site non officiel pour Kuskusi Kouture.`}>
  <nav class="wrap crumbs small" aria-label="Fil d’Ariane">
    <a href={url('collections/')}>Créations</a> <span aria-hidden="true">/</span>
    <a href={url(`collections/${line.slug}/`)}>{line.name}</a> <span aria-hidden="true">/</span>
    <span aria-current="page">Étude n°{piece.no}</span>
  </nav>

  <div class="wrap pdp" data-pdp data-slug={piece.slug}>
    <section class="gal" aria-label="Galerie">
      {piece.colours.map((c, ci) => (
        <div class="gal__set" data-set={c} hidden={ci !== 0}>
          <div class="gal__thumbs" role="group" aria-label={`Vues — ${colours[c].name}`}>
            {piece.views.map((v, vi) => (
              <button type="button" class="gal__thumb" data-go={vi} aria-label={`Vue ${vi + 1} : ${v.label}`} aria-current={vi === 0 ? 'true' : undefined}>
                <Plate silhouette={line.silhouette} colour={c} crop={v.crop} shot={v.shot} caption="none" uid={`t-${c}-${vi}`} decorative />
              </button>
            ))}
          </div>
          <div class="gal__track" data-track tabindex="0" aria-label="Images, faire défiler horizontalement" aria-roledescription="carrousel">
            {piece.views.map((v, vi) => (
              <div class="gal__slide" data-slide={vi} aria-label={`${vi + 1} sur ${piece.views.length} — ${v.label}`} role="group" aria-roledescription="diapositive">
                <button type="button" class="gal__zoom" data-zoom aria-label={`Agrandir la vue ${v.label}`}>
                  <Plate silhouette={line.silhouette} colour={c} crop={v.crop} shot={v.shot} numeral={v.crop === 'full' ? piece.no : undefined} caption="full" uid={`m-${c}-${vi}`} vt={ci === 0 && vi === 0 ? `piece-${piece.slug}` : undefined} />
                </button>
              </div>
            ))}
          </div>
          <div class="gal__bar" aria-hidden="true">
            <span data-counter>1 / {piece.views.length}</span>
            <span class="gal__dots">{piece.views.map((_, vi) => <i data-dot={vi} class={vi === 0 ? 'on' : ''}></i>)}</span>
          </div>
        </div>
      ))}
    </section>

    <section class="info" aria-labelledby="pdp-title">
      <div class="info__in">
        <p class="kicker">Étude n°{piece.no} · <a href={url(`collections/${line.slug}/`)}>{line.singular}</a></p>
        <h1 id="pdp-title" class="info__t">{piece.title}</h1>
        <p class="info__demo small"><strong>Pièce de démonstration.</strong> Nom, coloris et texte illustratifs — à remplacer par le modèle réel.</p>
        <p class="info__price">Prix sur demande</p>
        <p class="info__lead">{piece.lead}</p>

        <form class="opts" data-form novalidate>
          <fieldset class="opt">
            <legend><span class="kicker">Coloris</span> <span class="opt__val" data-colour-name>{colours[piece.colours[0]].name}</span></legend>
            <div class="sw">
              {piece.colours.map((c, i) => (
                <label class="sw__i" title={colours[c].name}>
                  <input type="radio" name="colour" value={c} checked={i === 0} class="sr-only" />
                  <span class="sw__c" style={`--c:${colours[c].cloth};--s:${colours[c].stitch}`} data-pois={colours[c].pattern ? '' : undefined}></span>
                  <span class="sr-only">{colours[c].name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="opt" aria-describedby="size-err">
            <legend><span class="kicker">Taille</span> <span class="opt__val" data-size-name>À choisir</span></legend>
            <div class="sz">
              {sizes.map((s) => (
                <label class:list={['sz__i', s === 'Sur mesure' && 'sz__i--wide']}>
                  <input type="radio" name="size" value={s} class="sr-only" />
                  <span>{s}</span>
                </label>
              ))}
            </div>
            <p id="size-err" class="opt__err small" data-size-err hidden>Choisissez une taille (ou « Sur mesure ») pour continuer.</p>
            <button type="button" class="link opt__guide" data-open-guide aria-haspopup="dialog" aria-controls="guide">Guide des tailles</button>
          </fieldset>

          <div class="opt opt--row">
            <span class="kicker" id="qty-l">Quantité</span>
            <div class="qty" role="group" aria-labelledby="qty-l">
              <button type="button" data-q="-1" aria-label="Diminuer la quantité">−</button>
              <output data-qty aria-live="polite">1</output>
              <button type="button" data-q="1" aria-label="Augmenter la quantité">+</button>
            </div>
          </div>

          <button type="submit" class="btn btn--solid add">Ajouter à ma sélection</button>
          <p class="small muted add__note">Démonstration : la sélection prépare une demande à envoyer vous-même à la maison. Aucune commande, aucun paiement.</p>
        </form>

        <div class="acc">
          <details><summary>Matières <em>à confirmer</em></summary><p>Composition et provenance des tissus à renseigner par la maison. Aucune information publique vérifiée à ce jour.</p></details>
          <details><summary>Façon & broderie <em>à confirmer</em></summary><p>Techniques de broderie, passementerie et finitions à décrire avec la maison — aucune mention n’est avancée ici sans source.</p></details>
          <details><summary>Entretien <em>à confirmer</em></summary><p>Conseils d’entretien à fournir pour chaque pièce.</p></details>
          <details><summary>Délais & livraison <em>à confirmer</em></summary><p>Délais de confection, retrait et expédition : modalités réelles à confirmer avec la maison.</p></details>
        </div>
      </div>
    </section>
  </div>

  <section class="wrap rel" aria-labelledby="rel-title">
    <h2 id="rel-title" class="rel__t">Pièces <em>en regard</em></h2>
    <div class="rel__grid">
      {rel.map((p) => <PieceCard piece={p} />)}
    </div>
  </section>

  <dialog id="guide" class="guide" aria-labelledby="guide-title">
    <div class="guide__top">
      <h2 id="guide-title" class="serif">Guide des tailles</h2>
      <button type="button" data-close class="guide__x">Fermer</button>
    </div>
    <p class="small"><strong>Tableau indicatif — à confirmer par la maison.</strong> Mesures du corps en centimètres, données à titre d’exemple de présentation.</p>
    <table>
      <caption class="sr-only">Correspondance des tailles (indicatif)</caption>
      <thead><tr><th scope="col">Taille</th><th scope="col">Poitrine</th><th scope="col">Taille</th><th scope="col">Hanches</th></tr></thead>
      <tbody>{guide.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
    </table>
    <p class="small muted">« Sur mesure » : proposition de parcours, à valider avec la maison (prise de mesures, essayages).</p>
  </dialog>

  <dialog id="zoom" class="zoom" aria-label="Image agrandie">
    <div class="zoom__bar">
      <span class="small" data-zoom-label></span>
      <div>
        <button type="button" data-zoom-prev aria-label="Vue précédente">←</button>
        <button type="button" data-zoom-toggle aria-pressed="false">Zoomer</button>
        <button type="button" data-zoom-next aria-label="Vue suivante">→</button>
        <button type="button" data-close>Fermer</button>
      </div>
    </div>
    <div class="zoom__stage" data-zoom-stage></div>
  </dialog>
</Base>

<script>
  import { bag } from '../../lib/chrome';
  import { announce, toast, openDialog, wireDialog } from '../../lib/chrome';
  import { colours } from '../../data/pieces';

  const root = document.querySelector<HTMLElement>('[data-pdp]')!;
  const slug = root.dataset.slug!;
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const sets = [...root.querySelectorAll<HTMLElement>('[data-set]')];
  let active = sets[0];
  let index = 0;

  const slides = (s = active) => [...s.querySelectorAll<HTMLElement>('[data-slide]')];
  const track = (s = active) => s.querySelector<HTMLElement>('[data-track]')!;

  function mark(i: number) {
    index = i;
    active.querySelectorAll('[data-go]').forEach((b, bi) => (bi === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
    active.querySelectorAll('[data-dot]').forEach((d, di) => d.classList.toggle('on', di === i));
    active.querySelector('[data-counter]')!.textContent = `${i + 1} / ${slides().length}`;
  }
  function go(i: number, smooth = true) {
    const s = slides();
    const n = (i + s.length) % s.length;
    const t = track();
    t.scrollTo({ left: s[n].offsetLeft - t.offsetLeft, top: 0, behavior: smooth && !matchMedia('(prefers-reduced-motion: reduce)').matches ? 'smooth' : 'auto' });
    mark(n);
  }
  sets.forEach((set) => {
    set.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
    const t = track(set);
    let raf = 0;
    t.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const i = Math.round(t.scrollLeft / t.clientWidth);
        if (set === active && i !== index) mark(Math.max(0, Math.min(i, slides().length - 1)));
      });
    }, { passive: true });
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });
  });

  // colour
  const colourName = form.querySelector('[data-colour-name]')!;
  function setColour(c: string) {
    const next = sets.find((s) => s.dataset.set === c);
    if (!next) return;
    sets.forEach((s) => (s.hidden = s !== next));
    active = next;
    colourName.textContent = colours[c].name;
    go(0, false);
  }
  form.querySelectorAll<HTMLInputElement>('input[name=colour]').forEach((r) => r.addEventListener('change', () => { setColour(r.value); announce(`Coloris : ${colours[r.value].name}`); }));
  const pre = new URLSearchParams(location.search).get('coloris');
  const preInput = pre ? form.querySelector<HTMLInputElement>(`input[name=colour][value="${CSS.escape(pre)}"]`) : null;
  if (preInput) { preInput.checked = true; setColour(pre!); }

  // size
  const sizeName = form.querySelector('[data-size-name]')!;
  const err = form.querySelector<HTMLElement>('[data-size-err]')!;
  form.querySelectorAll<HTMLInputElement>('input[name=size]').forEach((r) => r.addEventListener('change', () => { sizeName.textContent = r.value; err.hidden = true; }));

  // qty
  let qty = 1;
  const qOut = form.querySelector('[data-qty]')!;
  form.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => { qty = Math.max(1, Math.min(bag.MAX_QTY, qty + Number(b.dataset.q))); qOut.textContent = String(qty); }));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const colour = String(fd.get('colour') ?? '');
    const size = fd.get('size');
    if (!size) {
      err.hidden = false;
      form.querySelector<HTMLInputElement>('input[name=size]')!.focus();
      announce('Choisissez une taille pour continuer.');
      return;
    }
    if (bag.add({ slug, colour, size: String(size) }, qty)) {
      const msg = `Ajoutée à votre sélection : ${colours[colour].name}, taille ${size}${qty > 1 ? `, ×${qty}` : ''}.`;
      announce(msg);
      toast(msg, { label: 'Voir', run: () => openDialog(document.querySelector<HTMLDialogElement>('#bag')!) });
    }
  });

  // size guide
  const guide = document.querySelector<HTMLDialogElement>('#guide')!;
  document.querySelector('[data-open-guide]')!.addEventListener('click', () => openDialog(guide));
  wireDialog(guide);

  // zoom
  const zoom = document.querySelector<HTMLDialogElement>('#zoom')!;
  const stage = zoom.querySelector<HTMLElement>('[data-zoom-stage]')!;
  const zt = zoom.querySelector<HTMLButtonElement>('[data-zoom-toggle]')!;
  const zl = zoom.querySelector('[data-zoom-label]')!;
  let zi = 0;
  const showZoom = (i: number) => {
    const s = slides();
    zi = (i + s.length) % s.length;
    const fig = s[zi].querySelector('.plate')!.cloneNode(true) as HTMLElement;
    fig.style.removeProperty('view-transition-name');
    stage.replaceChildren(fig);
    setZ(false);
    zl.textContent = `${zi + 1} / ${s.length} — ${s[zi].getAttribute('aria-label')?.split('— ')[1] ?? ''}`;
  };
  const setZ = (on: boolean, x = 50, y = 50) => {
    stage.classList.toggle('on', on);
    stage.style.setProperty('--ox', `${x}%`);
    stage.style.setProperty('--oy', `${y}%`);
    zt.setAttribute('aria-pressed', String(on));
    zt.textContent = on ? 'Dézoomer' : 'Zoomer';
  };
  root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
    const i = slides().findIndex((s) => s.contains(b));
    showZoom(i < 0 ? 0 : i);
    openDialog(zoom);
  }));
  zt.addEventListener('click', () => setZ(!stage.classList.contains('on')));
  zoom.querySelector('[data-zoom-prev]')!.addEventListener('click', () => showZoom(zi - 1));
  zoom.querySelector('[data-zoom-next]')!.addEventListener('click', () => showZoom(zi + 1));
  const pos = (e: PointerEvent) => {
    const r = stage.getBoundingClientRect();
    return [((e.clientX - r.left) / r.width) * 100, ((e.clientY - r.top) / r.height) * 100] as const;
  };
  stage.addEventListener('click', (e) => { const [x, y] = pos(e as PointerEvent); setZ(!stage.classList.contains('on'), x, y); });
  stage.addEventListener('pointermove', (e) => { if (stage.classList.contains('on') && e.pointerType === 'mouse') { const [x, y] = pos(e); stage.style.setProperty('--ox', `${x}%`); stage.style.setProperty('--oy', `${y}%`); } });
  zoom.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') showZoom(zi + 1); if (e.key === 'ArrowLeft') showZoom(zi - 1); });
  zoom.addEventListener('close', () => go(zi, false));
  wireDialog(zoom);

</script>

<style>
  .crumbs { padding-top: 1rem; color: var(--ink-2); }
  .crumbs a { display: inline-flex; min-height: 44px; align-items: center; }
  .pdp { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); align-items: start; }
  .gal__set { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; }
  .gal__set[hidden] { display: none; }
  .gal__thumbs { display: flex; flex-direction: column; gap: 0.6rem; position: sticky; top: calc(var(--header-h) + 1rem); align-self: start; }
  .gal__thumb { padding: 0; border: 1px solid transparent; background: none; opacity: 0.6; transition: opacity 0.3s; }
  .gal__thumb[aria-current] { opacity: 1; border-color: var(--ink); }
  .gal__thumb:hover { opacity: 1; }
  .gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; }
  .gal__zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .gal__zoom :global(.plate) { aspect-ratio: 4 / 5; }
  .gal__bar { grid-column: 2; display: flex; justify-content: space-between; align-items: center; font: 500 0.6875rem/1 var(--sans); letter-spacing: 0.14em; }
  .gal__dots { display: flex; gap: 0.4rem; }
  .gal__dots i { width: 1.5rem; height: 2px; background: var(--line); transition: background 0.3s; }
  .gal__dots i.on { background: var(--ink); }

  .info__in { position: sticky; top: calc(var(--header-h) + 1.5rem); padding-bottom: 2rem; }
  .info__t { font-size: clamp(2.3rem, 4vw, 3.8rem); line-height: 1; margin: 0.9rem 0 1rem; }
  .info__demo { border-left: 2px solid var(--bottle); padding-left: 0.75rem; color: var(--ink-2); }
  .info__price { font: 500 0.875rem/1 var(--sans); letter-spacing: 0.06em; margin: 1.25rem 0; }
  .info__lead { color: var(--ink-2); max-width: 32rem; }
  .opts { margin-top: 1.75rem; display: grid; gap: 1.5rem; }
  .opt { border: 0; padding: 0; margin: 0; min-width: 0; }
  .opt legend { padding: 0; margin-bottom: 0.75rem; display: flex; gap: 0.75rem; align-items: baseline; }
  .opt__val { font-size: var(--fs-small); color: var(--ink-2); }
  .opt--row { display: flex; align-items: center; justify-content: space-between; }
  .sw { display: flex; gap: 0.5rem; }
  .sw__i { width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; border: 1px solid transparent; }
  .sw__c { width: 30px; height: 30px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px var(--line); }
  .sw__c[data-pois] { background: radial-gradient(circle, var(--s) 2px, var(--c) 2.4px) 0 0 / 8px 8px; }
  .sw__i:has(input:checked) { border-color: var(--ink); }
  .sw__i:has(input:focus-visible) { outline: 2px solid var(--bottle); outline-offset: 2px; }
  .sz { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem; }
  .sz__i { min-height: 44px; display: grid; place-items: center; border: 1px solid var(--line); cursor: pointer; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .sz__i--wide { grid-column: 1 / -1; }
  .sz__i:has(input:checked) { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .sz__i:has(input:focus-visible) { outline: 2px solid var(--bottle); outline-offset: 2px; }
  .sz__i:hover { border-color: var(--ink); }
  .opt__err { color: #8a2a17; margin: 0.6rem 0 0; font-weight: 600; }
  .opt__guide { margin-top: 0.5rem; }
  .add { width: 100%; min-height: 3.6rem; }
  .add__note { margin: -0.75rem 0 0; }
  .acc { margin-top: 2rem; border-top: 1px solid var(--line); }
  .acc details { border-bottom: 1px solid var(--line); }
  .acc summary { min-height: 3.25rem; display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary em { font: italic 400 0.875rem/1 var(--serif); letter-spacing: 0; text-transform: none; color: var(--ink-2); margin-left: auto; margin-right: 1rem; }
  .acc summary::after { content: '+'; font: 300 1.2rem/1 var(--sans); }
  .acc details[open] summary::after { content: '−'; }
  .acc details p { color: var(--ink-2); font-size: 0.9375rem; padding-bottom: 1rem; }

  .rel { margin-top: clamp(5rem, 10vw, 9rem); }
  .rel__t { font-size: var(--fs-2); margin-bottom: 2rem; }
  .rel__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }

  .guide { width: min(36rem, calc(100% - 2rem)); margin: auto; padding: 1.5rem; background: var(--paper); color: var(--ink); }
  .guide__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .guide__top h2 { font-size: 2rem; }
  .guide__x { background: none; border: 0; min-height: 44px; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .guide table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-variant-numeric: tabular-nums; font-size: 0.9375rem; }
  .guide th, .guide td { text-align: left; padding: 0.7rem 0.5rem; border-bottom: 1px solid var(--line); }
  .guide thead th { font: 600 0.6875rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }

  .zoom { width: 100%; height: 100%; height: 100dvh; margin: 0; background: var(--ink); color: var(--paper); flex-direction: column; display: none; }
  .zoom[open] { display: flex; }
  .zoom__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem var(--gutter); gap: 1rem; }
  .zoom__bar button { min-height: 44px; min-width: 44px; background: none; border: 1px solid rgb(255 255 255 / 0.3); color: var(--paper); font: 600 0.6875rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; padding: 0 0.9rem; }
  .zoom__bar div { display: flex; gap: 0.4rem; }
  .zoom__stage { flex: 1; overflow: hidden; display: grid; place-items: center; cursor: zoom-in; padding: 0 var(--gutter) var(--gutter); }
  .zoom__stage :global(.plate) { height: 100%; width: auto; max-width: 100%; aspect-ratio: 4 / 5; transition: transform 0.5s var(--ease); transform-origin: var(--ox) var(--oy); }
  .zoom__stage.on { cursor: zoom-out; }
  .zoom__stage.on :global(.plate) { transform: scale(2.4); }

  @media (max-width: 860px) {
    .pdp { grid-template-columns: 1fr; padding-inline: 0; }
    .gal__set { grid-template-columns: 1fr; gap: 0.75rem; }
    .gal__thumbs { display: none; }
    .gal__bar { grid-column: 1; padding-inline: var(--gutter); }
    .info { padding-inline: var(--gutter); }
    .info__in { position: static; }
    .rel__grid { grid-template-columns: 1fr 1fr; gap: 2rem 0.75rem; }
    .rel__grid > :global(:first-child) { grid-column: 1 / -1; }
    .zoom__bar { flex-wrap: wrap; }
    .zoom__stage :global(.plate) { width: 100%; height: auto; }
  }
</style>
