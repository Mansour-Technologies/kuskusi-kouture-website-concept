---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---
<Base title="Contact" current="contact/" description="Contacter Kuskusi Kouture via son compte Instagram officiel. Concept de site non officiel.">
  <section class="wrap ct">
    <p class="kicker">Contact</p>
    <h1 class="ct-title">Écrire<br /><em>à la maison.</em></h1>
    <div class="ct-grid">
      <div>
        <p class="ct-lead serif">Le canal public vérifié de la maison est son compte Instagram.</p>
        <a class="ct-ig" href={site.instagram.url} rel="noopener" target="_blank">@{site.instagram.handle}<span aria-hidden="true"> ↗</span><span class="sr-only"> — ouvrir Instagram dans un nouvel onglet</span></a>
        <p class="small muted">Ce site de démonstration n’envoie aucun message et ne collecte aucune donnée. Pour préparer une demande précise, composez d’abord votre <a href={url('selection/')}>sélection</a> : un récapitulatif à copier vous sera proposé.</p>
      </div>
      <div>
      <p class="kicker">À confirmer avec la maison</p>
      <dl class="ct-todo">
        <div><dt>Atelier / showroom</dt><dd>Adresse non publiée dans les sources consultées</dd></div>
        <div><dt>Rendez-vous</dt><dd>Modalités à définir</dd></div>
        <div><dt>WhatsApp</dt><dd>Numéro non vérifié — non affiché</dd></div>
        <div><dt>Livraison</dt><dd>Zones et délais à confirmer</dd></div>
      </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .ct { padding-top: clamp(2.5rem, 7vw, 6rem); }
  .ct-title { font-size: clamp(3.6rem, 12vw, 12rem); line-height: 0.85; margin: 1rem 0 clamp(3rem, 6vw, 5rem); letter-spacing: -0.04em; }
  .ct-grid { display: grid; grid-template-columns: 7fr 5fr; gap: calc(var(--gutter) * 2); align-items: start; }
  .ct-lead { font-size: var(--fs-3); line-height: 1.25; max-width: 26rem; }
  .ct-ig { display: inline-block; font-family: var(--serif); font-size: clamp(2.2rem, 6.5vw, 6rem); line-height: 1.1; text-decoration: none; border-bottom: 1px solid var(--ink); margin: 1rem 0 2rem; word-break: break-word; font-style: italic; }
  .ct-ig:hover { color: var(--bottle); }
  .ct-todo { margin: 0; }
  .ct-todo div { padding: 1rem 0; border-top: 1px solid var(--line); }
  .ct-todo dt { font: 600 0.6875rem/1.6 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .ct-todo dd { margin: 0.2rem 0 0; color: var(--ink-2); }
  @media (max-width: 860px) { .ct-grid { grid-template-columns: 1fr; } }
</style>
