---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Ma sélection" current="selection/" description="Votre sélection — démonstration d’une demande à adresser à la maison. Aucune commande, aucun paiement.">
  <section class="wrap sel">
    <div class="sel-head">
      <p class="kicker">Ma sélection · démonstration</p>
      <h1 class="sel-title">Votre <em>sélection</em></h1>
      <p class="muted measure">Rassemblez des pièces, ajustez les quantités, puis préparez un message récapitulatif. <strong>Rien n’est commandé ni envoyé</strong> : vous copiez le message et l’adressez vous-même à la maison.</p>
    </div>
    <div class="sel-grid">
      <div class="sel-list" data-sel-list aria-live="off"></div>
      <aside class="sel-side" data-sel-side aria-labelledby="compose-title">
        <h2 id="compose-title" class="serif">Préparer ma demande</h2>
        <ol class="sel-steps small">
          <li>Vérifiez coloris, tailles et quantités.</li>
          <li>Composez le message, puis copiez-le.</li>
          <li>Ouvrez Instagram et collez-le en message à <strong>@{site.instagram.handle}</strong>.</li>
        </ol>
        <button type="button" class="btn btn--solid" data-compose>Composer le message</button>
        <div class="sel-msg" data-msg hidden>
          <label for="msg" class="kicker">Message (non envoyé)</label>
          <textarea id="msg" rows="9" readonly data-msg-text></textarea>
          <div class="sel-actions">
            <button type="button" class="btn" data-copy>Copier le message</button>
            <a class="btn btn--solid" href={site.instagram.url} rel="noopener" target="_blank">Ouvrir Instagram<span class="sr-only"> (nouvel onglet)</span></a>
          </div>
          <p class="small muted" data-copy-status role="status"></p>
        </div>
        <hr class="stitch" />
        <button type="button" class="link" data-reset-demo>Réinitialiser la démo</button>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { bag, renderLines, announce } from '../lib/chrome';
  const list = document.querySelector<HTMLElement>('[data-sel-list]')!;
  const side = document.querySelector<HTMLElement>('[data-sel-side]')!;
  const msgBox = document.querySelector<HTMLElement>('[data-msg]')!;
  const txt = document.querySelector<HTMLTextAreaElement>('[data-msg-text]')!;
  const status = document.querySelector<HTMLElement>('[data-copy-status]')!;

  const compose = () => {
    const lines = bag.items().map((i) => {
      const d = bag.describe(i);
      return `— ${d.line.singular}, Étude n°${d.piece.no} « ${d.piece.title} » · ${d.colour.name} · taille ${i.size} · quantité ${i.qty}`;
    });
    return `Bonjour,\n\nJe suis intéressé(e) par les pièces suivantes :\n${lines.join('\n')}\n\nPourriez-vous m’indiquer disponibilités, prix et délais ?\nMerci !`;
  };
  const sync = () => {
    renderLines(list, { headingLevel: 2 });
    const has = bag.count() > 0;
    side.hidden = !has;
    if (!msgBox.hidden) txt.value = compose();
  };
  list.addEventListener('click', (e) => {
    // reuse drawer handlers through delegation in chrome: emulate
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLElement>('[data-key]');
    if (!li) return;
    const key = li.dataset.key!;
    const cur = bag.items().find((x) => `${x.slug}|${x.colour}|${x.size}` === key);
    if (!cur) return;
    if (t.closest('[data-inc]')) bag.setQty(key, cur.qty + 1);
    else if (t.closest('[data-dec]')) bag.setQty(key, cur.qty - 1);
    else if (t.closest('[data-rm]')) { bag.remove(key); announce('Pièce retirée de la sélection'); }
    const again = list.querySelector<HTMLElement>(`[data-key="${CSS.escape(key)}"] ${t.closest('[data-inc]') ? '[data-inc]' : '[data-dec]'}`);
    (again ?? list.querySelector<HTMLElement>('[data-rm], a'))?.focus();
  });
  document.querySelector('[data-compose]')!.addEventListener('click', () => {
    msgBox.hidden = false;
    txt.value = compose();
    txt.focus();
    announce('Message composé. Il n’est pas envoyé.');
  });
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(txt.value);
      status.textContent = 'Message copié dans le presse-papiers.';
    } catch {
      txt.select();
      status.textContent = 'Copie automatique indisponible : le texte est sélectionné, copiez-le manuellement.';
    }
  });
  document.querySelector('[data-reset-demo]')!.addEventListener('click', () => {
    try { localStorage.removeItem(bag.KEY); } catch { /* ignore */ }
    bag.clear();
    msgBox.hidden = true;
    announce('Démonstration réinitialisée');
  });
  document.addEventListener('bag:change', sync);
  sync();
</script>

<style>
  .sel { padding-top: clamp(2.5rem, 7vw, 6rem); }
  .sel-title { font-size: var(--fs-1); margin: 1rem 0 1.25rem; }
  .sel-grid { display: grid; grid-template-columns: 7fr 5fr; gap: calc(var(--gutter) * 2); margin-top: 3rem; align-items: start; }
  .sel-list { border-top: 1px solid var(--ink); }
  .sel-list :global(.bl) { grid-template-columns: 6rem 1fr auto; }
  .sel-side { position: sticky; top: calc(var(--header-h) + 1.5rem); background: var(--paper-2); padding: 1.75rem; display: grid; gap: 1.25rem; }
  .sel-side[hidden] { display: none; }
  .sel-side h2 { font-size: 2rem; }
  .sel-steps { margin: 0; padding-left: 1.2rem; color: var(--ink-2); display: grid; gap: 0.35rem; }
  .sel-msg { display: grid; gap: 0.6rem; }
  .sel-msg[hidden] { display: none; }
  .sel-msg textarea { width: 100%; border: 1px solid var(--line); background: var(--paper); padding: 0.9rem; font-size: 0.9375rem; line-height: 1.5; resize: vertical; }
  .sel-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .sel-actions .btn { padding: 0 0.75rem; }
  @media (max-width: 860px) { .sel-grid { grid-template-columns: 1fr; } .sel-side { position: static; } .sel-actions { grid-template-columns: 1fr; } }
</style>
