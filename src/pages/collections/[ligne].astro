---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import PieceCard from '../../components/PieceCard.astro';
import { lines, piecesOf, type Line } from '../../data/pieces';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return lines.map((l) => ({ params: { ligne: l.slug }, props: { line: l } }));
}
const { line } = Astro.props as { line: Line };
const list = piecesOf(line.slug);
const idx = lines.findIndex((l) => l.slug === line.slug);
const next = lines[(idx + 1) % lines.length];
---
<Base title={line.name} current="collections/" description={`${line.name} — sélection de démonstration. Concept de site non officiel pour Kuskusi Kouture.`}>
  <nav class="wrap crumbs small" aria-label="Fil d’Ariane">
    <a href={url('collections/')}>Créations</a> <span aria-hidden="true">/</span> <span aria-current="page">{line.name}</span>
  </nav>
  <section class="wrap l-hero">
    <div class="l-copy">
      <p class="kicker">Ligne {line.no} / 04</p>
      <h1 class="l-title">{line.name}</h1>
      <p class="l-intro serif">{line.intro}</p>
      <p class="small muted">Texte éditorial proposé — à valider par la maison.</p>
    </div>
    <div class="l-plate">
      <Plate silhouette={line.silhouette} colour={list[0].colours[0]} shot={line.shot} numeral={line.no} caption="full" uid={`l-${line.slug}`} />
    </div>
  </section>

  <section class="wrap" aria-label={`Pièces — ${line.name}`}>
    <div class="l-grid">
      {list.map((p, i) => <PieceCard piece={p} class={`l-c${i}`} ar={i === 1 ? '2 / 3' : '3 / 4'} />)}
    </div>
  </section>

  <aside class="wrap l-next">
    <p class="kicker">Ligne suivante</p>
    <a href={url(`collections/${next.slug}/`)} class="l-next__a"><span>{next.no}</span> {next.name} <span aria-hidden="true">→</span></a>
  </aside>
</Base>

<style>
  .crumbs { padding-top: 1.25rem; color: var(--ink-2); }
  .crumbs a { display: inline-flex; min-height: 44px; align-items: center; }
  .l-hero { display: grid; grid-template-columns: 7fr 5fr; gap: var(--gutter); align-items: end; padding-top: 1rem; }
  .l-title { font-size: clamp(4rem, 15vw, 15rem); line-height: 0.82; margin: 1rem 0 2rem; letter-spacing: -0.045em; }
  .l-intro { font-size: var(--fs-3); line-height: 1.3; max-width: 30rem; font-variation-settings: 'opsz' 28; }
  .l-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem var(--gutter); margin-top: clamp(4rem, 9vw, 8rem); align-items: start; }
  .l-grid > :global(.l-c0) { grid-column: 1 / span 4; margin-top: 18%; }
  .l-grid > :global(.l-c1) { grid-column: 5 / span 4; }
  .l-grid > :global(.l-c2) { grid-column: 9 / span 4; margin-top: 36%; }
  .l-next { margin-top: clamp(5rem, 10vw, 9rem); border-top: 1px solid var(--ink); padding-top: 1.5rem; }
  .l-next__a { font-family: var(--serif); font-size: var(--fs-1); text-decoration: none; display: inline-flex; gap: 1rem; align-items: baseline; }
  .l-next__a span:first-child { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.14em; }
  .l-next__a:hover { font-style: italic; }
  @media (max-width: 860px) {
    .l-hero { grid-template-columns: 1fr; }
    .l-title { font-size: 21vw; }
    .l-grid { grid-template-columns: 1fr 1fr; gap: 2.25rem 0.75rem; }
    .l-grid > :global(.l-c0) { grid-column: 1 / -1; margin: 0; }
    .l-grid > :global(.l-c1), .l-grid > :global(.l-c2) { grid-column: auto; margin: 0; }
    .l-grid > :global(.l-c2) { margin-top: 3rem; }
  }
</style>
