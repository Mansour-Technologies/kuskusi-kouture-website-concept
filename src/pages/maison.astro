---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { site } from '../data/site';
import { lines } from '../data/pieces';
import { url } from '../lib/url';
---
<Base title="La maison" current="maison/" description="La maison Kuskusi Kouture — repères vérifiés. Concept de site non officiel.">
  <section class="wrap m-hero">
    <p class="kicker">La maison</p>
    <h1 class="m-title">Kuskusi<br /><em>Kouture</em></h1>
  </section>

  <section class="wrap m-grid">
    <div class="m-plate">
      <Plate silhouette="djellaba" colour="noir" shot="portrait de la créatrice à l’atelier, mains au travail, sans pose — uniquement avec son accord" caption="full" uid="maison" numeral="Z" />
    </div>
    <div class="m-copy">
      <p class="m-lead serif">Derrière le nom, une signature : les créations de {site.designer}.</p>
      <p>La maison présente publiquement « les nouveautés, modèles et créations de {site.designer} » et décline son travail en quatre lignes — {lines.map((l) => l.name.toLowerCase()).join(', ').replace(/, ([^,]*)$/, ' et $1')}. Ses créations circulent sur Instagram, où la maison partage ses pièces avec sa communauté.</p>
      <p>Ce concept imagine l’étape suivante : un lieu à elle, éditorial et calme, où chaque pièce est présentée comme dans un magazine, et où l’on prépare une demande en quelques gestes.</p>
      <hr class="stitch" />
      <h2 class="m-h2">Repères vérifiés</h2>
      <dl class="m-facts">
        <div><dt>Compte officiel</dt><dd><a href={site.instagram.url} rel="noopener" target="_blank">Instagram @{site.instagram.handle}</a></dd></div>
        <div><dt>Créatrice</dt><dd>{site.designer} <span class="muted small">— d’après la page publique de la maison</span></dd></div>
        <div><dt>Lignes</dt><dd>Gandouras, djellabas, kaftans, tenues</dd></div>
        <div><dt>Rencontre</dt><dd>Parmi les labels présentés au Spring Pop-Up de Mooon Studio, Casablanca, avril 2026 <span class="muted small">— MWN Lifestyle, 16 avril 2026</span></dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap m-todo" aria-labelledby="todo-title">
    <h2 id="todo-title" class="m-h2">Chapitres à écrire <em>avec la maison</em></h2>
    <ol>
      <li><span class="serif">L’origine</span><p class="muted">Date de création, parcours, inspirations — rien n’est avancé ici sans la parole de la créatrice.</p></li>
      <li><span class="serif">L’atelier</span><p class="muted">Lieu, équipe, gestes de fabrication : à documenter et photographier.</p></li>
      <li><span class="serif">Le sur-mesure</span><p class="muted">Prise de mesures, essayages, délais — le parcours réel remplacera la proposition du site.</p></li>
    </ol>
  </section>
</Base>

<style>
  .m-hero { padding-top: clamp(2.5rem, 7vw, 6rem); }
  .m-title { font-size: clamp(4rem, 17vw, 17rem); line-height: 0.8; margin-top: 1rem; letter-spacing: -0.045em; }
  .m-title em { display: block; padding-left: 0.6em; }
  .m-grid { display: grid; grid-template-columns: 5fr 1fr 6fr; gap: var(--gutter); margin-top: clamp(3rem, 7vw, 6rem); align-items: start; }
  .m-plate { grid-column: 1; position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .m-copy { grid-column: 3; max-width: 38rem; }
  .m-lead { font-size: var(--fs-2); line-height: 1.08; margin-bottom: 2rem; }
  .m-copy > p:not(.m-lead) { color: var(--ink-2); }
  .m-copy .stitch { margin-block: 3rem 2.5rem; }
  .m-h2 { font-size: var(--fs-3); margin-bottom: 1.5rem; }
  .m-facts { margin: 0; }
  .m-facts div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .m-facts dt { font: 600 0.6875rem/1.6 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .m-facts dd { margin: 0; }
  .m-facts a { display: inline-flex; min-height: 44px; align-items: center; margin-top: -0.6rem; }
  .m-todo { margin-top: clamp(5rem, 10vw, 9rem); }
  .m-todo .m-h2 { font-size: var(--fs-2); }
  .m-todo ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); counter-reset: c; }
  .m-todo li { border-top: 1px solid var(--ink); padding-top: 1.25rem; }
  .m-todo li .serif { font-size: 1.9rem; display: block; margin-bottom: 0.5rem; }
  @media (max-width: 860px) {
    .m-grid { grid-template-columns: 1fr; }
    .m-plate, .m-copy { grid-column: 1; position: static; }
    .m-todo ol { grid-template-columns: 1fr; }
    .m-facts div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
