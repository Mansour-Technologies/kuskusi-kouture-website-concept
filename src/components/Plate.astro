---
/**
 * Fashion croquis of a real Kuskusi Kouture piece: elongated (~9 heads) figure in a fine navy ink line
 * (the monogram's ink), garment in a translucent watercolour wash of the real colours, signature detail
 * marked precisely. Original drawing that ECHOES the official photograph; the photo itself is only shown
 * through Instagram's official embed. Shared filters (#kw wash, #kb brush) live once in Base.astro.
 */
import type { Piece } from '../data/collections';
interface Props { piece: Piece; uid: string; class?: string }
const { piece, uid, class: cls } = Astro.props;
const [c0, c1, c2] = piece.colors;
const g = piece.garment;
const INK = '#1D2447';
const id = (s: string) => `${s}-${uid}`;
const arch = 'M0 400 V150 C0 72 62 20 150 4 C238 20 300 72 300 150 V400 Z';
const stroke = piece.scene === 'velours' ? '#6E1E26' : piece.scene === 'cedre' ? '#8A5A3A' : piece.scene === 'salon' ? '#B8924A' : '#D9CBB6';
const tilt = ['robe-safran', 'jellaba-ivoire', 'kimono-satin', 'gandoura-doree', 'kimono-lin', 'gandoura-satin'].includes(piece.id) ? -1.2 : 1.2;

const waves = (x1: number, x2: number, y: number, n: number, d: number) => {
  const step = (x2 - x1) / n;
  let p = '';
  for (let i = 0; i < n; i++) { const a = x2 - i * step; p += ` Q${(a - step / 2).toFixed(1)} ${y - d} ${(a - step).toFixed(1)} ${y}`; }
  return p;
};
const hand = (x: number, y: number, d = 1) => `M${x - 3 * d} ${y} C${x - 5 * d} ${y + 8} ${x - 4 * d} ${y + 15} ${x} ${y + 19} C${x + 3 * d} ${y + 20} ${x + 4 * d} ${y + 16} ${x + 3 * d} ${y + 10} L${x + 3 * d} ${y}`;
const range = (a: number, b: number, s: number) => { const o: number[] = []; for (let v = a; v <= b + 0.01; v += s) o.push(+v.toFixed(1)); return o; };

/* Shared silhouettes */
const longBody = 'M118 80 Q150 74 182 80 C188 160 196 280 206 384 Q150 392 94 384 C104 280 112 160 118 80 Z';
const sleeveL = 'M118 82 C104 94 98 140 94 186 L90 232 L118 236 C120 196 122 158 124 124';
const sleeveR = 'M182 82 C196 94 202 140 206 186 L210 232 L182 236 C180 196 178 158 176 124';
const gandoura = 'M108 96 L192 96 L224 150 L204 160 C208 240 212 318 216 386 Q150 394 84 386 C88 318 92 240 96 160 L76 150 Z';
---
<figure class:list={['plate', cls]} data-piece={piece.id}>
  <svg viewBox="0 0 300 400" role="img" aria-label={`Croquis original : ${piece.echo}`}>
    <clipPath id={id('a')}><path d={arch} /></clipPath>
    <g clip-path={`url(#${id('a')})`}>
      <rect width="300" height="400" fill="#F8F3EA" />
      {/* a single limewash brush stroke, tinted after the post's setting */}
      <path d="M40 330 C70 250 60 150 120 96 C170 52 238 70 262 140 C282 200 250 300 230 360 C190 380 100 380 40 330 Z" fill={stroke} opacity="0.22" filter="url(#kb)" />
      <path d="M22 400 V160 C22 92 76 44 150 30 C224 44 278 92 278 160 V400" fill="none" stroke={INK} stroke-opacity="0.12" stroke-width="0.8" />

      <g transform={`rotate(${tilt} 150 220)`} stroke-linecap="round" stroke-linejoin="round">
        {/* ——— hair wash (behind) ——— */}
        {g !== 'jellabaHood' && <path d="M141 17 C129 19 124 32 126 50 C128 72 122 92 116 108 L129 106 C135 88 138 70 139 56 C137 42 137 29 142 21 Z M159 17 C171 19 176 32 174 50 C172 72 178 92 184 108 L171 106 C165 88 162 70 161 56 C163 42 163 29 158 21 Z M140 18 Q150 11 160 18 Q151 23 141 22 Z" fill="#2B211C" opacity="0.42" filter="url(#kw)" />}

        {/* ——— GARMENT WASHES ——— */}
        {g === 'wrap' && (
          <g filter="url(#kw)">
            <path d="M122 80 Q150 74 178 81 C182 110 170 134 166 150 C176 210 194 296 212 360 Q150 372 86 362 C104 296 124 210 134 150 C130 130 118 108 122 80 Z" fill={c0} opacity="0.82" />
            <path d={`M86 360 Q150 372 212 360 C220 370 228 380 236 390${waves(64, 236, 390, 11, 8)} C70 380 78 370 86 360 Z`} fill={c0} opacity="0.88" />
            <path d="M122 82 C108 92 104 130 104 170 C104 200 106 220 110 234 L124 232 C122 208 124 180 128 150 C130 122 130 100 128 88 Z M178 82 C192 92 196 130 196 170 C196 200 194 220 190 234 L176 232 C178 208 176 180 172 150 C170 122 170 100 172 88 Z" fill={c0} opacity="0.8" />
            <path d="M166 150 C178 214 194 296 208 356 L186 358 C176 300 166 220 160 160 Z" fill={c1} opacity="0.35" />
          </g>
        )}
        {(g === 'jellaba' || g === 'jellabaHood') && (
          <g filter="url(#kw)">
            <path d={longBody} fill={c0} opacity="0.8" />
            <path d={`${sleeveL} Z ${sleeveR} Z`} fill={c0} opacity="0.85" />
            <path d="M168 120 C176 200 186 300 196 384 L176 386 C170 300 164 200 160 124 Z" fill={c1} opacity="0.3" />
            {g === 'jellabaHood' && <path d="M118 84 C112 50 124 10 150 8 C176 10 188 50 182 84 C172 76 166 70 164 58 C166 40 160 24 150 23 C140 24 134 40 136 58 C134 70 128 76 118 84 Z" fill={c0} opacity="0.85" />}
            {g === 'jellaba' && <path d="M88 226 L118 230 L118 240 L87 236 Z M212 226 L182 230 L182 240 L213 236 Z" fill={c2} opacity="0.85" />}
          </g>
        )}
        {(g === 'kimonoSatin' || g === 'kimonoPrint' || g === 'kimonoLace' || g === 'bomber') && (
          <g filter="url(#kw)">
            <path d="M130 150 L170 150 C176 230 182 320 188 384 L160 386 L150 236 L140 386 L112 384 C118 320 124 230 130 150 Z" fill={g === 'kimonoLace' ? '#1B1B22' : g === 'kimonoPrint' ? '#D8C8AC' : '#EFE7D8'} opacity={g === 'kimonoLace' ? 0.82 : 0.7} />
            <path d="M134 80 L166 80 L168 154 L132 154 Z" fill={g === 'kimonoLace' ? '#1B1B22' : '#FFFFFF'} opacity="0.7" />
          </g>
        )}
        {(g === 'kimonoSatin' || g === 'kimonoPrint') && (
          <g filter="url(#kw)">
            <path d={`M120 80 L142 80 L140 150 L138 ${g === 'kimonoPrint' ? 290 : 318} L104 ${g === 'kimonoPrint' ? 290 : 318} C108 230 112 150 120 80 Z M180 80 L158 80 L160 150 L162 ${g === 'kimonoPrint' ? 290 : 318} L196 ${g === 'kimonoPrint' ? 290 : 318} C192 230 188 150 180 80 Z`} fill={c0} opacity={g === 'kimonoPrint' ? 0.75 : 0.85} />
            <path d="M120 82 C106 92 100 126 96 166 L92 222 L118 226 L122 150 Z M180 82 C194 92 200 126 204 166 L208 222 L182 226 L178 150 Z" fill={c0} opacity="0.8" />
            {g === 'kimonoSatin' && <path d="M112 120 C110 180 110 240 112 300 M188 130 C190 190 190 250 188 300" stroke="#fff" stroke-width="4" opacity="0.7" fill="none" />}
            {g === 'kimonoPrint' && [[114, 110, 0], [170, 104, 1], [108, 200, 1], [182, 190, 0], [120, 260, 0], [176, 262, 1], [98, 160, 1], [196, 150, 0]].map(([x, y, k]) => (
              <path d={`M${x} ${y} c6 -10 16 -14 22 -12 c-2 8 -12 14 -22 12 Z`} fill={k ? c2 : c1} opacity="0.85" />
            ))}
          </g>
        )}
        {g === 'kimonoLace' && (
          <g filter="url(#kw)">
            <path d="M120 80 L142 80 L140 234 L108 234 C110 180 114 130 120 80 Z M180 80 L158 80 L160 234 L192 234 C190 180 186 130 180 80 Z M120 82 C106 92 100 126 96 160 L92 204 L120 206 L122 140 Z M180 82 C194 92 200 126 204 160 L208 204 L180 206 L178 140 Z" fill="#FFFFFF" opacity="0.9" />
          </g>
        )}
        {g === 'bomber' && (
          <g filter="url(#kw)">
            <path d="M118 80 Q150 74 182 80 C186 120 188 160 188 204 L112 204 C112 160 114 120 118 80 Z M118 82 C106 92 100 126 98 166 L96 214 L118 216 L120 150 Z M182 82 C194 92 200 126 202 166 L204 214 L182 216 L180 150 Z" fill={c0} opacity="0.85" />
            <path d="M112 168 L188 168 L188 194 L112 194 Z" fill={c2} opacity="0.55" />
          </g>
        )}
        {g === 'gandoura' && (
          <g filter="url(#kw)">
            <path d={gandoura} fill={c0} opacity={piece.id === 'gandoura-fleurie' ? 0.55 : 0.85} />
            <path d="M176 160 C186 240 196 320 204 386 L184 388 C178 320 170 240 166 164 Z" fill={c1} opacity="0.3" />
            {piece.id === 'gandoura-fleurie' && [[118, 130], [160, 120], [138, 182], [182, 200], [110, 236], [150, 260], [190, 286], [120, 316], [164, 340], [100, 360], [196, 356]].map(([x, y]) => (
              <g><circle cx={x} cy={y} r="5.5" fill={c1} opacity="0.75" /><path d={`M${x + 5} ${y + 3} c6 -2 9 3 7 6 c-4 0 -7 -2 -7 -6 Z`} fill={c2} opacity="0.8" /></g>
            ))}
            {piece.id === 'gandoura-satin' && <path d="M110 150 C106 220 104 300 104 370 M190 160 C194 230 196 300 196 370" stroke="#fff" stroke-width="5" opacity="0.6" fill="none" />}
          </g>
        )}

        {/* ——— INK: head & figure (a few strokes, no skin fill) ——— */}
        <g fill="none" stroke={INK} stroke-width="1.1">
          {g !== 'jellabaHood' && <path d="M150 14 C134 14 126 28 127 48 C128 70 123 90 116 108 M150 14 C166 14 174 28 173 48 C172 68 177 88 184 108 M139 24 C134 40 136 62 132 84 M161 24 C166 40 164 62 168 84" stroke-width="0.9" />}
          <path d="M141 30 C139 42 141 52 147 57 C150 59 153 58 156 55" />
          <path d="M143 37 h4.5 M153 37 h4.5 M150.5 40 l-1 6.5 h2 M147 51 q3 1.6 6 0" stroke-width="0.8" />
          <path d="M145 58 L144 74 M155 58 L156 74" />
          {g === 'jellabaHood' && <path d="M118 84 C112 50 124 10 150 8 C176 10 188 50 182 84 M136 58 C134 40 140 24 150 23 C160 24 166 40 164 58 C166 70 172 76 182 84 M136 58 C134 70 128 76 118 84 M128 30 C124 50 126 66 130 74" />}
          {g === 'kimonoLace' && <path d="M124 86 C130 72 140 64 150 62 C160 64 170 72 176 86" stroke-dasharray="1.5 2.5" />}
        </g>

        {/* ——— INK: garment construction & signature details ——— */}
        <g fill="none" stroke={INK} stroke-width="1.1">
          {g === 'wrap' && (
            <g>
              <path d="M122 80 Q150 74 178 81 C182 110 170 134 166 150 C176 210 194 296 212 360 M122 80 C118 108 130 130 134 150 C124 210 104 296 86 362" />
              <path d={`M86 360 Q150 372 212 360 C220 370 228 380 236 390${waves(64, 236, 390, 11, 8)} C70 380 78 370 86 360`} />
              <path d="M122 82 C108 92 104 130 104 170 C104 200 106 220 110 234 M124 232 C122 208 124 180 128 150 M178 82 C192 92 196 130 196 170 C196 200 194 220 190 234 M176 232 C178 208 176 180 172 150 M108 234 h16 M176 234 h16" />
              <path d={`${hand(116, 236)} ${hand(184, 236, -1)}`} stroke-width="0.8" />
              <path d="M134 80 L150 122 L167 81 M150 122 C158 136 164 144 167 151" />
              {range(0, 7, 1).map((k) => (<><circle cx={135 + k * 1.95} cy={84 + k * 5.1} r="1.3" fill="#FFFDF7" /><circle cx={166 - k * 2.1} cy={85 + k * 5.0} r="1.3" fill="#FFFDF7" /></>))}
              <path d="M167 152 C173 180 175 210 171 242 M169 152 C178 172 184 196 185 216" />
              <path d="M140 200 C132 260 120 320 112 360 M160 196 C162 260 166 320 168 362 M186 250 C194 300 200 334 204 358" stroke-width="0.6" opacity="0.7" />
            </g>
          )}
          {(g === 'jellaba' || g === 'jellabaHood') && (
            <g>
              <path d="M118 80 Q150 74 182 80 M118 80 C112 160 104 280 94 384 M182 80 C188 160 196 280 206 384 M94 384 Q150 392 206 384" />
              <path d={`${sleeveL} M${sleeveR.slice(1)}`} />
              <path d={`${hand(104, 238)} ${hand(196, 238, -1)}`} stroke-width="0.8" />
              <path d="M150 140 C149 220 148 300 148 386 M128 160 C122 240 114 320 108 384 M172 160 C178 240 186 320 192 384" stroke-width="0.6" opacity="0.6" />
            </g>
          )}
          {g === 'jellaba' && (
            <g>
              <path d="M141 80 L150 96 L159 80" stroke="#141414" stroke-width="1.6" />
              {range(102, 378, 7.2).map((y) => <circle cx={150 + (y - 102) * -0.006} cy={y} r="1.7" fill="#141414" stroke="none" />)}
              <path d="M146 100 L146 382 M154 100 L154 382" stroke-width="0.5" opacity="0.5" />
            </g>
          )}
          {g === 'jellabaHood' && (
            <g>
              <path d="M150 80 L150 128 M144 80 L150 128 L156 80" stroke={c2} stroke-width="1.6" />
              <path d="M150 128 L150 146 M150 146 c-4 6 -5 14 0 22 c5 -8 4 -16 0 -22 Z M146 156 l-2 10 M154 156 l2 10" />
              {[[122, 108], [158, 108], [122, 142], [158, 142]].map(([x, y]) => (
                <g stroke={c2} stroke-width="1">
                  <path d={`M${x + 10} ${y} L${x + 20} ${y + 14} L${x + 10} ${y + 28} L${x} ${y + 14} Z M${x + 10} ${y + 6} L${x + 15} ${y + 14} L${x + 10} ${y + 22} L${x + 5} ${y + 14} Z`} />
                  <path d={`M${x + 2} ${y + 2} l4 -4 l4 4 M${x + 10} ${y - 2} v-0 M${x + 18} ${y + 2} l-4 -4 M${x + 2} ${y + 26} l4 4 l4 -4 M${x + 18} ${y + 26} l-4 4`} />
                </g>
              ))}
              <path d="M90 228 L118 232 M210 228 L182 232" stroke={c2} stroke-width="2" />
            </g>
          )}
          {(g === 'kimonoSatin' || g === 'kimonoPrint' || g === 'kimonoLace' || g === 'bomber') && (
            <path d="M130 150 C124 230 118 320 112 384 M170 150 C176 230 182 320 188 384 M150 236 L140 386 M150 236 L160 386 M112 384 h28 M160 386 h28 M120 386 c-4 4 -8 6 -12 6 h14 M180 388 c4 4 8 6 12 6 h-14" />
          )}
          {(g === 'kimonoSatin' || g === 'kimonoPrint') && (
            <g>
              <path d={`M120 80 C112 150 108 230 104 ${g === 'kimonoPrint' ? 290 : 318} L138 ${g === 'kimonoPrint' ? 290 : 318} M180 80 C188 150 192 230 196 ${g === 'kimonoPrint' ? 290 : 318} L162 ${g === 'kimonoPrint' ? 290 : 318}`} />
              <path d={`M142 78 L140 150 L138 ${g === 'kimonoPrint' ? 290 : 318} M158 78 L160 150 L162 ${g === 'kimonoPrint' ? 290 : 318} M134 80 L138 150 M166 80 L162 150`} />
              <path d="M120 82 C106 92 100 126 96 166 L92 222 L118 226 L122 150 M180 82 C194 92 200 126 204 166 L208 222 L182 226 L178 150" />
              <path d={`${hand(105, 226)} ${hand(195, 226, -1)}`} stroke-width="0.8" />
              <path d="M108 196 L192 196 M108 204 L192 204 M150 200 C146 222 144 240 142 262 M152 202 C160 220 164 238 166 254" />
            </g>
          )}
          {g === 'kimonoLace' && (
            <g>
              <path d="M120 80 C114 130 110 180 108 234 M180 80 C186 130 190 180 192 234 M142 80 L140 234 M158 80 L160 234" />
              <path d={`M108 234${'q4 6 8 0 '.repeat(4)} M160 234${'q4 6 8 0 '.repeat(4)}`} />
              <path d="M120 82 C106 92 100 126 96 160 L92 204 M180 82 C194 92 200 126 204 160 L208 204 M122 140 L120 206 M178 140 L180 206" />
              <path d={`M92 204${'q3.5 5 7 0 '.repeat(4)} M180 206${'q3.5 5 7 0 '.repeat(4)}`} />
              {[[118, 110], [130, 150], [116, 196], [168, 104], [176, 146], [182, 200], [104, 170], [196, 172], [128, 218], [172, 222]].map(([x, y]) => (
                <path d={`M${x} ${y} m-3 0 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0 M${x - 5} ${y + 7} q5 -3 10 0`} stroke-width="0.7" />
              ))}
            </g>
          )}
          {g === 'bomber' && (
            <g>
              <path d="M118 80 Q150 74 182 80 C186 120 188 160 188 204 L112 204 C112 160 114 120 118 80 Z" />
              <path d="M118 82 C106 92 100 126 98 166 L96 214 L118 216 L120 150 M182 82 C194 92 200 126 202 166 L204 214 L182 216 L180 150" />
              <path d="M112 196 h76 M112 200 h76 M96 208 l22 2 M204 208 l-22 2 M150 82 L150 204 M134 80 C140 88 160 88 166 80" />
              <path d={`${hand(107, 216)} ${hand(193, 216, -1)}`} stroke-width="0.8" />
              {[[124, 106], [140, 124], [164, 110], [176, 132], [126, 146], [170, 152]].map(([x, y]) => <path d={`M${x} ${y} c3 -6 8 -7 10 -5 c-1 4 -6 7 -10 5 Z`} stroke={c1} stroke-width="0.9" />)}
              <path d={`M112 172${' q4.75 -7 9.5 0'.repeat(8)} M112 188${' q4.75 7 9.5 0'.repeat(8)}`} stroke="#B8924A" stroke-width="1" />
              {range(116.5, 184, 9.5).map((x) => <circle cx={x} cy="180" r="1.4" fill="#B8924A" stroke="none" />)}
            </g>
          )}
          {g === 'gandoura' && (
            <g>
              <path d={gandoura} />
              <path d="M145 72 C136 82 124 88 108 96 M155 72 C164 82 176 88 192 96" stroke-width="0.9" />
              <path d={`M80 152 C82 190 84 220 86 242 M96 160 C96 196 96 222 95 242 M220 152 C218 190 216 220 214 242 M204 160 C204 196 204 222 205 242 ${hand(91, 242)} ${hand(209, 242, -1)}`} stroke-width="0.8" />
              <path d="M108 96 L192 96 M108 103 L192 103" stroke={piece.id === 'gandoura-fleurie' ? c1 : INK} stroke-width={piece.id === 'gandoura-fleurie' ? 2.2 : 1} />
              {piece.id === 'gandoura-fleurie' && range(112, 188, 6).map((x) => <path d={`M${x} 97.5 l3 4 M${x + 3} 97.5 l-3 4`} stroke={c1} stroke-width="0.9" />)}
              <path d="M147 102 C144 116 142 128 140 140 M153 102 C156 116 158 128 160 140" stroke={piece.id === 'gandoura-doree' ? '#B8924A' : INK} />
              <path d="M140 140 c-4 6 -5 14 0 22 c5 -8 4 -16 0 -22 Z M160 140 c-4 6 -5 14 0 22 c5 -8 4 -16 0 -22 Z M138 150 l-1 10 M142 150 l1 10 M158 150 l-1 10 M162 150 l1 10" stroke={piece.id === 'gandoura-doree' ? '#B8924A' : INK} stroke-width="0.9" />
              {(piece.id === 'gandoura-doree' || piece.id === 'gandoura-jacquard') && [[118, 140], [176, 136], [130, 200], [168, 214], [112, 262], [150, 280], [190, 270], [124, 330], [172, 340]].map(([x, y]) => (
                <path d={`M${x} ${y - 7} c5 4 5 10 0 14 c-5 -4 -5 -10 0 -14 Z M${x - 6} ${y + 9} q6 -4 12 0`} stroke={piece.id === 'gandoura-doree' ? '#B8924A' : c2} stroke-width="0.8" />
              ))}
              <path d="M126 170 C122 240 114 320 108 386 M176 170 C180 240 188 320 194 388" stroke-width="0.6" opacity="0.6" />
            </g>
          )}
        </g>
      </g>
    </g>
    <path d={arch} fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</figure>

<style>
  .plate { margin: 0; position: relative; aspect-ratio: 3 / 4; color: var(--encre); }
  .plate svg { display: block; width: 100%; height: 100%; }
</style>
