---
/**
 * "Fiche" dialog: the art-directed drawing of a real piece, the house's own caption, and —
 * only on click — Instagram's official embed of the original post (no image is rehosted).
 */
import Plate from './Plate.astro';
import { pieces, igPost, igEmbed } from '../data/collections';
import { site } from '../data/site';
---
{pieces.map((p) => (
  <template id={`tpl-${p.id}`}><Plate piece={p} uid={`f-${p.id}`} /></template>
))}
<script type="application/json" id="pieces-data" set:html={JSON.stringify(pieces.map((p) => ({ id: p.id, name: p.name, date: p.date, caption: p.caption, echo: p.echo, post: igPost(p.code), embed: igEmbed(p.code), swatches: p.swatches, chapter: p.chapter })))} />

<dialog id="lightbox" class="lb" aria-labelledby="lb-title">
  <button type="button" class="lb__close" data-close>Fermer</button>
  <div class="lb__inner">
    <div class="lb__stage" data-lb-stage aria-live="polite"></div>
    <div class="lb__info">
      <div class="lb__top">
        <p class="kicker" data-lb-count>1 / {pieces.length}</p>
      </div>
      <p class="kicker lb__date">Publication Instagram · <span data-lb-date></span></p>
      <h2 id="lb-title" class="lb__name" data-lb-name></h2>
      <blockquote class="lb__cap">
        <p data-lb-caption></p>
        <footer class="small">— légende de la maison, @{site.instagram.handle}</footer>
      </blockquote>
      <ul class="lb__sw" data-lb-swatches aria-label="Couleurs observées"></ul>
      <p class="small muted lb__echo"><strong>Illustration originale</strong> d’après la photo officielle : <span data-lb-echo></span></p>
      <div class="lb__actions">
        <button type="button" class="btn btn--solid" data-lb-embed>Afficher la photo officielle</button>
        <a class="btn" data-lb-post href={site.instagram.url} target="_blank" rel="noopener noreferrer">Ouvrir sur Instagram<span class="sr-only"> (nouvel onglet)</span></a>
        <a class="link lb__cta" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">Demander ce modèle en message<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
      </div>
      <p class="small muted lb__priv">La photo officielle est chargée depuis Instagram (Meta) uniquement si vous cliquez.</p>
      <div class="lb__nav">
        <button type="button" data-lb-prev aria-label="Pièce précédente">←</button>
        <button type="button" data-lb-next aria-label="Pièce suivante">→</button>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  .lb { width: min(1180px, 100%); height: 100%; height: 100dvh; max-height: 100dvh; margin: 0 auto; background: var(--blanc); color: var(--encre); display: none; }
  .lb[open] { display: block; animation: lbIn 0.5s var(--ease); }
  @keyframes lbIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .lb__inner { display: grid; grid-template-columns: 1.05fr 1fr; height: 100%; }
  .lb__stage { background: var(--chaux); display: grid; place-items: center; align-content: center; padding: clamp(1rem, 4vw, 3rem); overflow: auto; touch-action: pan-y; }
  .lb__stage .plate { width: min(100%, 460px); }
  .lb__info { padding: clamp(1.25rem, 3.5vw, 3rem); display: flex; flex-direction: column; gap: 1rem; overflow: auto; }
  .lb__top { display: flex; justify-content: space-between; align-items: center; }
  .lb { position: relative; }
  .lb__close { position: absolute; top: 0.5rem; right: 0.75rem; z-index: 3; background: var(--blanc); padding: 0 0.75rem; border: 0; min-height: 44px; min-width: 44px; font: 600 0.71875rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; }
  .lb__date { color: var(--encre-2); margin: 0; }
  .lb__name { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .lb__cap { margin: 0; padding-left: 1rem; border-left: 2px solid var(--safran); }
  .lb__cap p { font-family: var(--serif); font-style: italic; font-size: 1.2rem; line-height: 1.4; margin: 0 0 0.4rem; font-variation-settings: 'opsz' 28; }
  .lb__cap footer { color: var(--encre-2); }
  .lb__sw { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; margin: 0; padding: 0; font-size: var(--fs-small); }
  .lb__sw li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .lb__sw i { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1px solid var(--line); }
  .lb__echo { margin: 0; }
  .lb__actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: center; margin-top: 0.25rem; }
  .lb__priv { margin: 0; }
  .lb__nav { display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; }
  .lb__nav button { width: 3.25rem; height: 3.25rem; border: 1px solid var(--encre); background: none; font-size: 1.2rem; }
  .lb__nav button:hover { background: var(--encre); color: var(--blanc); }
  @media (max-width: 820px) {
    .lb__inner { grid-template-columns: 1fr; grid-template-rows: auto auto; height: auto; min-height: 100%; }
    .lb { overflow: auto; }
    .lb__stage { padding: 1rem 2.5rem; }
    .lb__stage .plate { width: min(100%, 250px); }
    .lb__info { overflow: visible; }
  }
</style>
