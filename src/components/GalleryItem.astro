---
/** A gallery plate that opens the shared lightbox. */
import Plate from './Plate.astro';
import type { Silhouette, Crop } from '../data/collections';

interface Props {
  silhouette: Silhouette;
  colour: string;
  crop?: Crop;
  shot: string;
  ref: string;
  line: string;
  numeral?: string;
  uid: string;
  class?: string;
  ar?: string;
  caption?: boolean;
}
const { silhouette, colour, crop = 'full', shot, ref, line, numeral, uid, ar = '3 / 4', caption = true } = Astro.props;
---
<figure class:list={['gi', Astro.props.class]}>
  <button type="button" class="gi__btn" data-lb data-ref={ref} data-line={line} data-shot={shot} aria-haspopup="dialog" aria-controls="lightbox" aria-label={`Agrandir — ${line}, ${ref}`} style={`--ar:${ar}`}>
    <Plate silhouette={silhouette} colour={colour} crop={crop} shot={shot} numeral={numeral} caption="none" uid={uid} decorative />
    <span class="gi__plus" aria-hidden="true">+</span>
  </button>
  {caption && (
    <figcaption class="gi__cap">
      <span class="gi__ref">{ref}</span>
      <span class="gi__shot">Photo à venir — {shot}</span>
    </figcaption>
  )}
</figure>

<style>
  .gi { margin: 0; }
  .gi__btn { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; overflow: hidden; }
  .gi__btn :global(.plate) { aspect-ratio: var(--ar); }
  .gi__btn :global(.plate__figure) { transition: transform 1.2s var(--ease); }
  .gi__btn:hover :global(.plate__figure), .gi__btn:focus-visible :global(.plate__figure) { transform: scale(1.045); }
  .gi__plus { position: absolute; right: 0.75rem; top: 0.75rem; width: 2.25rem; height: 2.25rem; display: grid; place-items: center; background: var(--paper); color: var(--ink); font: 300 1.3rem/1 var(--sans); opacity: 0; transform: scale(0.8); transition: opacity 0.4s, transform 0.5s var(--ease); }
  .gi__btn:hover .gi__plus, .gi__btn:focus-visible .gi__plus { opacity: 1; transform: none; }
  @media (hover: none) { .gi__plus { opacity: 1; transform: none; width: 2rem; height: 2rem; } }
  .gi__cap { display: flex; gap: 0.75rem; align-items: baseline; padding-top: 0.7rem; font-size: var(--fs-small); color: var(--ink-2); line-height: 1.4; }
  .gi__ref { font: 600 0.6875rem/1 var(--sans); letter-spacing: 0.14em; color: var(--ink); white-space: nowrap; }
  :global(.on-dark) .gi__cap, :global(.on-dark) .gi__ref { color: inherit; }
</style>
