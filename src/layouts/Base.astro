---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../styles/global.css';
import { site, nav } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  tone?: 'light' | 'dark';
  current?: string;
}
const { title, description = site.description, tone = 'light', current = '' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name} · Concept` : `${site.name} · Concept de site vitrine (démonstration)`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url('og.png'), Astro.site).href;
/** Anchors resolve against the home page so they work from the lookbook too. */
const href = (h: string) => (h.startsWith('#') ? `${url()}${h}` : url(h));
---
<!doctype html>
<html lang="fr" class="no-js" style={`--grain:url('${url('grain.svg')}')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kuskusi Kouture — concept de site non officiel par Mansour Technologies" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
  </head>
  <body data-tone={tone}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <p class="notice" data-notice>{site.notice}</p>

    <header class:list={['hdr', tone === 'dark' && 'hdr--dark']} data-header>
      <nav class="hdr__nav" aria-label="Navigation principale">
        <ul>
          {nav.map((n) => (
            <li><a href={href(n.href)} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="hdr__mark" href={url()} aria-label="Kuskusi Kouture — accueil">
        <span class="hdr__k">Kuskusi</span> <em>Kouture</em>
      </a>
      <div class="hdr__end">
        <a class="hdr__dm" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">Écrire à la maison<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
        <button class="hdr__menu" type="button" data-open-menu aria-haspopup="dialog" aria-controls="menu">Menu</button>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="ftr on-dark">
      <div class="wrap ftr__grid">
        <p class="ftr__mark serif" aria-hidden="true">Kuskusi <em>Kouture</em></p>
        <div>
          <p class="kicker">Sur cette page</p>
          <ul>
            {nav.map((n) => <li><a href={href(n.href)}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="kicker">Canal officiel</p>
          <ul>
            <li><a href={site.instagram.url} rel="noopener noreferrer" target="_blank">Instagram @{site.instagram.handle}<span class="sr-only"> (nouvel onglet)</span></a></li>
            <li><a href={site.instagram.dm} rel="noopener noreferrer" target="_blank">Message direct<span class="sr-only"> sur Instagram (nouvel onglet)</span></a></li>
          </ul>
        </div>
        <div class="ftr__legal">
          <p>{site.notice}</p>
          <p>Ce site n’est ni commandé, ni approuvé par Kuskusi Kouture. Visuels : compositions originales, en attente des photographies de la maison.</p>
          <p><a href={site.attribution.url} rel="noopener">{site.attribution.label}</a></p>
        </div>
      </div>
    </footer>

    <dialog id="menu" class="menu on-dark" aria-label="Menu">
      <div class="menu__top">
        <span class="serif menu__mk">Kuskusi <em>Kouture</em></span>
        <button type="button" class="menu__close" data-close>Fermer</button>
      </div>
      <ol class="menu__list">
        {nav.map((n, i) => <li><a href={href(n.href)}><small>{String(i + 1).padStart(2, '0')}</small>{n.label}</a></li>)}
      </ol>
      <div class="menu__foot">
        <a class="btn btn--light" href={site.instagram.dm} target="_blank" rel="noopener noreferrer">Écrire sur Instagram<span class="sr-only"> (nouvel onglet)</span></a>
        <p class="small">{site.notice}</p>
      </div>
    </dialog>

    <script>
      import { initChrome } from '../lib/chrome';
      initChrome();
    </script>
  </body>
</html>

<style is:global>
  .notice { margin: 0; padding: 0.5rem var(--gutter); background: var(--ink); color: #d9d8d2; font-size: var(--fs-micro); letter-spacing: 0.06em; text-align: center; line-height: 1.4; }

  .hdr { position: sticky; top: 0; z-index: 40; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--header-h); padding-inline: var(--gutter); background: var(--paper); color: var(--ink); border-bottom: 1px solid var(--line); transition: background-color 0.5s, color 0.5s, border-color 0.5s; }
  .hdr--dark:not(.is-solid) { background: var(--bottle); color: var(--embroidery); border-color: transparent; }
  .hdr__nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a, .hdr__dm, .hdr__menu { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; background: none; border: 0; padding: 0; min-height: 44px; display: inline-flex; align-items: center; gap: 0.45rem; }
  .hdr__nav a { background-image: linear-gradient(currentColor, currentColor); background-size: 0 1px; background-repeat: no-repeat; background-position: 0 calc(50% + 0.85em); transition: background-size 0.45s var(--ease); }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { background-size: 100% 1px; }
  .hdr__mark { font-family: var(--serif); font-size: 1.35rem; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; font-variation-settings: 'opsz' 28; display: inline-flex; align-items: center; min-height: 44px; gap: 0.3em; }
  .hdr__k { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.92em; }
  .hdr__end { display: flex; justify-content: flex-end; gap: 1.5rem; }
  .hdr__dm { border: 1px solid currentColor; padding: 0 1rem; min-height: 40px; transition: background-color 0.3s, color 0.3s; }
  .hdr__dm:hover { background: var(--ink); color: var(--paper); }
  .hdr--dark:not(.is-solid) .hdr__dm:hover { background: var(--embroidery); color: var(--bottle); }
  .hdr__menu { display: none; }

  @media (max-width: 1024px) {
    .hdr { grid-template-columns: 1fr auto; }
    .hdr__nav, .hdr__dm { display: none; }
    .hdr__menu { display: inline-flex; padding-left: 1rem; }
  }

  .ftr { background: var(--bottle); color: var(--embroidery); padding-block: clamp(4rem, 9vw, 8rem) 3rem; }
  .ftr__grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2.5rem 3rem; }
  .ftr__mark { grid-column: 1 / -1; font-size: clamp(3.4rem, 14vw, 13rem); line-height: 0.85; margin: 0 0 2rem; text-transform: uppercase; letter-spacing: -0.03em; }
  .ftr__mark em { text-transform: none; }
  .ftr ul { list-style: none; margin: 0.9rem 0 0; padding: 0; }
  .ftr li a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  .ftr li a:hover { text-decoration: underline; }
  .ftr__legal { grid-column: 1 / -1; border-top: 1px solid color-mix(in srgb, var(--embroidery) 25%, transparent); padding-top: 1.5rem; font-size: var(--fs-small); color: #d5ddd7; display: grid; gap: 0.25rem; }
  .ftr__legal a { color: var(--embroidery); display: inline-flex; min-height: 44px; align-items: center; }
  @media (max-width: 860px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__grid > div:first-of-type { grid-column: auto; } }
  @media (max-width: 480px) { .ftr__grid { grid-template-columns: 1fr; } }

  dialog { padding: 0; border: 0; max-width: none; max-height: none; }
  dialog::backdrop { background: rgb(18 18 17 / 0.55); }
  .menu { width: 100%; height: 100%; height: 100dvh; margin: 0; background: var(--bottle); color: var(--embroidery); padding: 0 var(--gutter) calc(1.5rem + env(safe-area-inset-bottom)); display: none; flex-direction: column; }
  .menu[open] { display: flex; animation: menuIn 0.55s var(--ease); }
  @keyframes menuIn { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .menu__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .menu__mk { font-size: 1.2rem; }
  .menu__close { background: none; border: 0; min-height: 44px; min-width: 44px; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; }
  .menu__list { list-style: none; margin: auto 0; padding: 0; }
  .menu__list a { display: flex; align-items: baseline; gap: 1rem; font-family: var(--serif); font-size: clamp(2.6rem, 12vw, 5rem); line-height: 1.1; text-decoration: none; font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; }
  .menu__list a:hover { font-style: italic; }
  .menu__list small { font: 500 0.6875rem/1 var(--sans); letter-spacing: 0.14em; opacity: 0.7; }
  .menu__list li { opacity: 0; transform: translateY(16px); animation: itemIn 0.7s var(--ease) forwards; }
  .menu__list li:nth-child(2) { animation-delay: 0.05s; } .menu__list li:nth-child(3) { animation-delay: 0.1s; } .menu__list li:nth-child(4) { animation-delay: 0.15s; } .menu__list li:nth-child(5) { animation-delay: 0.2s; }
  @keyframes itemIn { to { opacity: 1; transform: none; } }
  .menu__foot { display: grid; gap: 1rem; color: #d5ddd7; }
  .menu__foot .btn { width: 100%; }
</style>
