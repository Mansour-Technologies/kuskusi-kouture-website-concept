---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../styles/global.css';
import { site, nav } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  tone?: 'light' | 'dark';
  current?: string;
}
const { title, description = site.description, tone = 'light', current = '' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name} · Concept` : `${site.name} · Concept de site (démonstration)`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="fr" class="no-js" style={`--grain:url('${url('grain.svg')}')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kuskusi Kouture — concept de site non officiel par Mansour Technologies" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
  </head>
  <body data-tone={tone}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <p class="notice" data-notice>
      <span>{site.notice}</span>
    </p>

    <header class:list={['hdr', tone === 'dark' && 'hdr--dark']} data-header>
      <nav class="hdr__nav" aria-label="Navigation principale">
        <ul>
          {nav.map((n) => (
            <li><a href={url(n.href)} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="hdr__mark" href={url()} aria-label="Kuskusi Kouture — accueil">
        <span class="hdr__k">Kuskusi</span> <em>Kouture</em>
      </a>
      <div class="hdr__end">
        <button class="hdr__menu" type="button" data-open-menu aria-haspopup="dialog" aria-controls="menu">Menu</button>
        <button class="hdr__bag" type="button" data-open-bag aria-haspopup="dialog" aria-controls="bag">
          Sélection <span class="count" data-bag-count>0</span><span class="sr-only"> pièce(s)</span>
        </button>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="ftr on-dark">
      <div class="wrap ftr__grid">
        <p class="ftr__mark serif" aria-hidden="true">Kuskusi <em>Kouture</em></p>
        <div>
          <p class="kicker">La maison</p>
          <ul>
            {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
            <li><a href={url('selection/')}>Ma sélection</a></li>
          </ul>
        </div>
        <div>
          <p class="kicker">Canal public vérifié</p>
          <ul>
            <li><a href={site.instagram.url} rel="noopener" target="_blank">Instagram @{site.instagram.handle}<span class="sr-only"> (nouvel onglet)</span></a></li>
          </ul>
        </div>
        <div class="ftr__legal">
          <p>{site.notice}</p>
          <p>Ce site n’est ni commandé, ni approuvé par Kuskusi Kouture. Visuels : compositions originales, en attente des photographies de la maison. Aucune commande, aucun paiement.</p>
          <p><a href={site.attribution.url} rel="noopener">{site.attribution.label}</a></p>
        </div>
      </div>
    </footer>

    <!-- Mobile thumb bar -->
    <nav class="thumb" aria-label="Raccourcis">
      <button type="button" data-open-menu aria-haspopup="dialog" aria-controls="menu">Menu</button>
      <a href={url('collections/')} aria-current={current === 'collections/' ? 'page' : undefined}>Créations</a>
      <button type="button" data-open-bag aria-haspopup="dialog" aria-controls="bag">Sélection <span class="count" data-bag-count>0</span></button>
    </nav>

    <dialog id="menu" class="menu on-dark" aria-label="Menu">
      <div class="menu__top">
        <span class="serif menu__mk">Kuskusi <em>Kouture</em></span>
        <button type="button" class="menu__close" data-close>Fermer</button>
      </div>
      <ol class="menu__list">
        <li><a href={url()}><small>00</small>Accueil</a></li>
        {nav.map((n, i) => <li><a href={url(n.href)}><small>{String(i + 1).padStart(2, '0')}</small>{n.label}</a></li>)}
        <li><a href={url('selection/')}><small>05</small>Ma sélection</a></li>
      </ol>
      <p class="menu__foot small"><a href={site.instagram.url} rel="noopener" target="_blank">Instagram @{site.instagram.handle}</a><br />{site.notice}</p>
    </dialog>

    <dialog id="bag" class="drawer" aria-labelledby="bag-title">
      <div class="drawer__top">
        <h2 id="bag-title" class="serif">Votre sélection</h2>
        <button type="button" class="drawer__close" data-close>Fermer</button>
      </div>
      <p class="drawer__demo kicker">Démonstration — aucune commande, aucun paiement</p>
      <div class="drawer__body" data-bag-list></div>
      <div class="drawer__foot" data-bag-foot>
        <a class="btn btn--solid" href={url('selection/')}>Préparer ma demande</a>
        <button type="button" class="link drawer__clear" data-bag-clear>Vider la sélection</button>
      </div>
    </dialog>

    <div class="sr-only" aria-live="polite" data-live></div>
    <div class="toast" role="status" data-toast hidden></div>

    <script>
      import { initChrome } from '../lib/chrome';
      initChrome();
    </script>
  </body>
</html>

<style is:global>
  .notice { margin: 0; padding: 0.5rem var(--gutter); background: var(--ink); color: #d9d8d2; font-size: var(--fs-micro); letter-spacing: 0.06em; text-align: center; line-height: 1.4; }

  .hdr { position: sticky; top: 0; z-index: 40; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--header-h); padding-inline: var(--gutter); background: var(--paper); color: var(--ink); border-bottom: 1px solid var(--line); transition: background-color 0.5s, color 0.5s, border-color 0.5s; }
  .hdr--dark:not(.is-solid) { background: var(--bottle); color: var(--embroidery); border-color: transparent; }
  .hdr__nav ul { display: flex; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a, .hdr__bag, .hdr__menu { font: 500 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; background: none; border: 0; padding: 0; min-height: 44px; display: inline-flex; align-items: center; gap: 0.45rem; }
  .hdr__nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.5em; }
  .hdr__mark { font-family: var(--serif); font-size: 1.35rem; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; font-variation-settings: 'opsz' 28; display: inline-flex; align-items: center; min-height: 44px; gap: 0.3em; }
  .hdr__k { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.92em; }
  .hdr__end { display: flex; justify-content: flex-end; gap: 1.5rem; }
  .hdr__menu { display: none; }
  .count { display: inline-grid; place-items: center; min-width: 1.45rem; height: 1.45rem; padding: 0 0.3rem; border: 1px solid currentColor; border-radius: 50%; font-size: 0.6875rem; letter-spacing: 0; }
  .count.bump { animation: bump 0.5s var(--ease); }
  @keyframes bump { 40% { transform: scale(1.35); } }

  .thumb { display: none; }

  @media (max-width: 860px) {
    .hdr { grid-template-columns: 1fr; justify-items: center; }
    .hdr__nav { display: none; }
    .hdr__mark { font-size: 1.2rem; }
    .hdr__end .hdr__bag { display: none; }
    .hdr__menu { display: inline-flex; }
    .hdr__end { display: none; }
    .thumb { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(3, 1fr); background: var(--paper); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
    .thumb > * { min-height: 3.5rem; display: flex; align-items: center; justify-content: center; gap: 0.45rem; background: none; border: 0; font: 600 0.6875rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; color: var(--ink); }
    .thumb > * + * { border-left: 1px solid var(--line); }
    .thumb a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.45em; }
    body { padding-bottom: calc(3.5rem + env(safe-area-inset-bottom)); }
  }

  .ftr { background: var(--bottle); color: var(--embroidery); padding-block: clamp(4rem, 9vw, 8rem) 3rem; margin-top: clamp(4rem, 10vw, 9rem); }
  .ftr__grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2.5rem 3rem; }
  .ftr__mark { grid-column: 1 / -1; font-size: clamp(3.4rem, 14vw, 13rem); line-height: 0.85; margin: 0 0 2rem; text-transform: uppercase; letter-spacing: -0.03em; }
  .ftr__mark em { text-transform: none; }
  .ftr ul { list-style: none; margin: 0.9rem 0 0; padding: 0; }
  .ftr li a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  .ftr li a:hover { text-decoration: underline; }
  .ftr__legal { grid-column: 1 / -1; border-top: 1px solid color-mix(in srgb, var(--embroidery) 25%, transparent); padding-top: 1.5rem; font-size: var(--fs-small); color: #d5ddd7; display: grid; gap: 0.25rem; }
  .ftr__legal a { color: var(--embroidery); display: inline-flex; min-height: 44px; align-items: center; }
  @media (max-width: 860px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__grid > div:first-of-type { grid-column: auto; } }
  @media (max-width: 480px) { .ftr__grid { grid-template-columns: 1fr; } }

  dialog { padding: 0; border: 0; max-width: none; max-height: none; }
  dialog::backdrop { background: rgb(18 18 17 / 0.45); }
  .menu { width: 100%; height: 100%; height: 100dvh; margin: 0; background: var(--bottle); color: var(--embroidery); padding: 0 var(--gutter) calc(1.5rem + env(safe-area-inset-bottom)); display: none; flex-direction: column; }
  .menu[open] { display: flex; animation: menuIn 0.55s var(--ease); }
  @keyframes menuIn { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .menu__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .menu__mk { font-size: 1.2rem; }
  .menu__close, .drawer__close { background: none; border: 0; min-height: 44px; min-width: 44px; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; }
  .menu__list { list-style: none; margin: auto 0; padding: 0; }
  .menu__list a { display: flex; align-items: baseline; gap: 1rem; font-family: var(--serif); font-size: clamp(2.6rem, 12vw, 5rem); line-height: 1.08; text-decoration: none; font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; }
  .menu__list small { font: 500 0.6875rem/1 var(--sans); letter-spacing: 0.14em; opacity: 0.7; }
  .menu__list li { opacity: 0; transform: translateY(16px); animation: itemIn 0.7s var(--ease) forwards; }
  .menu__list li:nth-child(2) { animation-delay: 0.05s; } .menu__list li:nth-child(3) { animation-delay: 0.1s; } .menu__list li:nth-child(4) { animation-delay: 0.15s; } .menu__list li:nth-child(5) { animation-delay: 0.2s; } .menu__list li:nth-child(6) { animation-delay: 0.25s; }
  @keyframes itemIn { to { opacity: 1; transform: none; } }
  .menu__foot { color: #d5ddd7; }
  .menu__foot a { display: inline-flex; min-height: 44px; align-items: center; color: var(--embroidery); }

  .drawer { margin: 0 0 0 auto; width: min(30rem, 100%); height: 100%; height: 100dvh; background: var(--paper); color: var(--ink); display: none; flex-direction: column; }
  .drawer[open] { display: flex; animation: drawerIn 0.5s var(--ease); }
  @keyframes drawerIn { from { transform: translateX(100%); } }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; padding: 1rem var(--gutter) 0.5rem; }
  .drawer__top h2 { font-size: 2rem; }
  .drawer__demo { padding: 0 var(--gutter) 1rem; color: var(--ink-2); border-bottom: 1px solid var(--line); margin: 0; }
  .drawer__body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 0 var(--gutter); }
  .drawer__foot { padding: 1rem var(--gutter) calc(1rem + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); display: grid; gap: 0.5rem; justify-items: center; }
  .drawer__foot .btn { width: 100%; }
  .drawer__foot[hidden] { display: none; }
  @media (max-width: 860px) {
    .drawer { margin: auto 0 0; width: 100%; height: fit-content; max-height: 88dvh; }
    .drawer__body { flex: 0 1 auto; }
    .drawer[open] { animation-name: sheetIn; }
    @keyframes sheetIn { from { transform: translateY(100%); } }
  }

  /* bag line (shared drawer + page) */
  .bl { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  .bl__sw { aspect-ratio: 3/4; background: var(--sw); position: relative; display: grid; place-items: center; font: italic 1.6rem/1 var(--serif); color: var(--swc); }
  .bl__sw[data-pois] { background-image: radial-gradient(circle, var(--swc) 2.2px, transparent 2.6px), radial-gradient(circle, var(--swc) 2.2px, transparent 2.6px); background-size: 12px 12px; background-position: 0 0, 6px 6px; }
  .bl__t { font-family: var(--serif); font-size: 1.2rem; line-height: 1.15; text-decoration: none; display: block; margin-bottom: 0.35rem; }
  .bl__m { font-size: var(--fs-small); color: var(--ink-2); margin: 0 0 0.6rem; }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--line); }
  .qty button { width: 44px; height: 44px; background: none; border: 0; font-size: 1.1rem; }
  .qty output { min-width: 2rem; text-align: center; font-variant-numeric: tabular-nums; }
  .bl__rm { background: none; border: 0; font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 0.2em; min-height: 44px; padding: 0 0.25rem; color: var(--ink-2); }
  .empty { padding: 3rem 0; text-align: left; }
  .empty h3 { font-size: 2rem; margin-bottom: 0.75rem; }

  .toast { position: fixed; z-index: 60; left: 50%; bottom: calc(4.5rem + env(safe-area-inset-bottom)); transform: translateX(-50%); background: var(--ink); color: var(--paper); padding: 0.9rem 1.25rem; font-size: var(--fs-small); max-width: calc(100% - 2rem); display: flex; gap: 1rem; align-items: center; }
  .toast[hidden] { display: none; }
  .toast button { background: none; border: 0; color: var(--paper); text-decoration: underline; min-height: 44px; font-weight: 600; }
  @media (min-width: 861px) { .toast { bottom: 2rem; } }
</style>
